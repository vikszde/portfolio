---
// Site navigation from the Figma "Nav" and "Nav / Mobile" components. Desktop
// shows the wordmark, links and tagline; below 768px it collapses to the logo
// icon and a Menu button that opens a full-screen menu.
import Logo from "./Logo.astro";
import Sparkle from "./Sparkle.astro";
import Halftone from "./Halftone.astro";

interface Props {
  current?: "Home" | "Work" | "About" | "Playground" | "Contact";
}

// Left out (the 404 page), no link is marked as the current page.
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// `section` is the home page section a link stands for, so the indicator can
// follow it while the home page scrolls. Work and About go to their own pages
// but still light up over the home page's matching sections.
const links: { label: NonNullable<Props["current"]>; href: string; section?: string }[] = [
  { label: "Home", href: base },
  { label: "Work", href: `${base}work/`, section: "work" },
  { label: "About", href: `${base}about/`, section: "about" },
  { label: "Playground", href: `${base}playground/` },
  { label: "Contact", href: `${base}#contact`, section: "contact" },
];
---

<header class="nav" data-nav>
  <div class="nav__bar theme-dark">
    <a class="nav__home" href={base}>
      <span class="nav__wordmark"><Logo variant="wordmark" height={48} /></span>
      <span class="nav__icon"><Logo variant="icon" height={40} /></span>
      <span class="visually-hidden">Viktória Varga, home</span>
    </a>

    <nav class="nav__links" aria-label="Main">
      <ul>
        <li class="nav__indicator" aria-hidden="true"></li>
        {
          links.map(({ label, href, section }) => (
            <li>
              <a
                class="nav__link text-label-strong"
                href={href}
                aria-current={label === current ? "page" : undefined}
                data-section={section}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <Sparkle color="ink" size={24} class="nav__spark" />
    </nav>

    <p class="nav__tagline text-label-s">Ideas · Design · Illustration<br />for a brighter tomorrow.</p>

    <button class="nav__toggle text-label-strong" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-open>
      Menu
      <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true"><path d="M0 1.25H18M0 7H18M0 12.75H18" stroke="currentColor" stroke-width="2.5"></path></svg>
    </button>

    <span class="nav__progress" aria-hidden="true"></span>
  </div>

  <div class="menu" id="mobile-menu" hidden data-menu>
    <span class="menu__ink" aria-hidden="true" data-menu-ink></span>
    <div class="menu__bar">
      <a href={base} class="nav__home"><Logo variant="icon" height={40} /><span class="visually-hidden">Home</span></a>
      <button class="menu__close text-label-strong" type="button" data-menu-close>
        Close
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 2L14 14M14 2L2 14" stroke="currentColor" stroke-width="2.5"></path></svg>
      </button>
    </div>
    <nav aria-label="Main">
      <ol class="menu__links">
        {
          links.map(({ label, href }, i) => (
            <li>
              <a class="menu__link" href={href} aria-current={label === current ? "page" : undefined}>
                <span class="menu__number text-label-m">{String(i + 1).padStart(2, "0")}</span>
                <span class="text-h2">{label}</span>
                {label === current && <Sparkle color="pink" size={28} />}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="menu__footer">
      <p class="text-katakana" lang="ja">つくる、試す、<br />好きで満たす。</p>
      <p class="text-label-m menu__tagline">Ideas · Design · Illustration<br />for a brighter tomorrow.</p>
    </div>
    <div class="menu__halftone"><Halftone height={140} /></div>
  </div>
</header>
<div class="nav-spacer" aria-hidden="true"></div>

<script>
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");

  /*
   * Opening, the menu sweeps in from the right behind a slanted black ink
   * stripe (the same slant as the page transitions' panels), then the links
   * slide in one after another, the close button pops and the footer rises.
   * Closing sweeps it back out. With reduced motion it just appears.
   */
  const ink = menu?.querySelector<HTMLElement>("[data-menu-ink]");
  const stillMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const sweepEase = "cubic-bezier(0.8, 0, 0.2, 1)";
  const settle = "cubic-bezier(0.16, 1, 0.3, 1)";
  // The menu shows everything right of a "/" edge whose bottom sits at a%;
  // the ink stripe rides just inside that edge. At a = 100 nothing shows; at
  // a = -34 the menu covers the screen and the stripe has left it.
  const sweep = (a: number) => `polygon(${a + 20}% 0%, 100% 0%, 100% 100%, ${a}% 100%)`;
  const stripe = (a: number) => `polygon(${a + 20}% 0%, ${a + 34}% 0%, ${a + 14}% 100%, ${a}% 100%)`;

  function stopMotion() {
    menu?.getAnimations({ subtree: true }).forEach((a) => a.cancel());
  }

  function playOpen(menu: HTMLElement) {
    menu.animate([{ clipPath: sweep(100) }, { clipPath: sweep(-34) }], { duration: 460, easing: sweepEase });
    ink?.animate([{ clipPath: stripe(100) }, { clipPath: stripe(-34) }], { duration: 460, easing: sweepEase });
    menu.querySelectorAll<HTMLElement>(".menu__link").forEach((link, i) => {
      link.animate(
        [
          { opacity: 0, transform: "translateX(-48px) skewX(-14deg)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 520, delay: 200 + i * 55, easing: settle, fill: "backwards" },
      );
    });
    menu.querySelector<HTMLElement>(".menu__link[aria-current] svg")?.animate(
      [
        { transform: "scale(0) rotate(-180deg)" },
        { transform: "scale(1) rotate(0deg)" },
      ],
      { duration: 500, delay: 520, easing: "cubic-bezier(0.34, 1.56, 0.64, 1)", fill: "backwards" },
    );
    closeButton?.animate(
      [
        { opacity: 0, transform: "scale(0.6) rotate(-8deg)" },
        { opacity: 1, transform: "none" },
      ],
      { duration: 420, delay: 160, easing: "cubic-bezier(0.34, 1.56, 0.64, 1)", fill: "backwards" },
    );
    menu.querySelectorAll<HTMLElement>(".menu__footer, .menu__halftone").forEach((part, i) => {
      part.animate(
        [
          { opacity: 0, transform: "translateY(24px)" },
          { opacity: 1, transform: "none" },
        ],
        { duration: 520, delay: 460 + i * 90, easing: settle, fill: "backwards" },
      );
    });
  }

  async function playClose(menu: HTMLElement) {
    menu.querySelectorAll<HTMLElement>(".menu__links, .menu__footer, .menu__halftone").forEach((part) => {
      part.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 140, fill: "forwards" });
    });
    ink?.animate([{ clipPath: stripe(-34) }, { clipPath: stripe(100) }], { duration: 380, delay: 60, easing: sweepEase });
    await menu.animate([{ clipPath: sweep(-34) }, { clipPath: sweep(100) }], {
      duration: 380,
      delay: 60,
      easing: sweepEase,
      fill: "forwards",
    }).finished;
  }

  async function setOpen(open: boolean, animate = true) {
    if (!menu || !openButton) return;
    stopMotion();
    openButton.setAttribute("aria-expanded", String(open));
    if (open) {
      menu.hidden = false;
      menu.scrollTop = 0;
      document.documentElement.classList.add("menu-open");
      if (animate && !stillMotion()) playOpen(menu);
      menu.querySelector<HTMLAnchorElement>(".menu__link")?.focus();
      return;
    }
    openButton.focus();
    if (animate && !stillMotion() && !menu.hidden) {
      try {
        await playClose(menu);
      } catch {
        // Cancelled: the menu was opened again mid-close.
        return;
      }
    }
    menu.hidden = true;
    document.documentElement.classList.remove("menu-open");
    stopMotion();
  }

  openButton?.addEventListener("click", () => setOpen(true));
  closeButton?.addEventListener("click", () => setOpen(false));
  menu?.addEventListener("click", (event) => {
    const link = (event.target as HTMLElement).closest("a");
    if (!link) return;
    const url = new URL(link.href, location.href);
    if (url.pathname === location.pathname && url.search === location.search) {
      // A section on this page: sweep the menu away to show it.
      setOpen(false);
    } else {
      // Another page: its page transition covers the menu on the way out.
      // Close it then, without animation, so Back doesn't return to it open.
      window.addEventListener("pagehide", () => setOpen(false, false), { once: true });
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.hidden) setOpen(false);
  });
  // Leaving the mobile breakpoint with the menu open would strand it.
  window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
    if (event.matches && menu && !menu.hidden) setOpen(false, false);
  });

  /*
   * Scroll behaviour: the bar sticks to the top and turns compact once the
   * page scrolls, slides away while scrolling down and comes back on any
   * scroll up. A pink line along its bottom edge shows reading progress and
   * stays on screen even while the bar is slid away, and
   * on the home page an ink block slides to the section being read.
   */
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const indicator = nav?.querySelector<HTMLElement>(".nav__indicator");
  const navLinks = [...(nav?.querySelectorAll<HTMLAnchorElement>(".nav__link") ?? [])];
  const sections = navLinks
    .map((link) => ({ link, section: link.dataset.section ? document.getElementById(link.dataset.section) : null }))
    .filter((item): item is { link: HTMLAnchorElement; section: HTMLElement } => item.section !== null);
  // The current page's own link: lit whenever none of the sections is being
  // read. Not only Home: the About page has a Contact section of its own, and
  // above it About must stay lit.
  const pageLink = navLinks.find((link) => link.getAttribute("aria-current") === "page") ?? null;
  let active = pageLink;

  function moveIndicator(link: HTMLAnchorElement | null) {
    if (!indicator) return;
    navLinks.forEach((l) => l.classList.toggle("is-active", l === link));
    if (!link) {
      indicator.style.opacity = "0";
      return;
    }
    indicator.style.opacity = "1";
    indicator.style.width = `${link.offsetWidth}px`;
    indicator.style.translate = `${link.parentElement!.offsetLeft}px 0`;
  }

  let lastY = window.scrollY;
  let ticking = false;

  function update() {
    ticking = false;
    if (!nav) return;
    const y = window.scrollY;
    const menuOpen = document.documentElement.classList.contains("menu-open");
    // Two thresholds, so hovering around one point can't make it flicker.
    if (y > 40) nav.classList.add("is-compact");
    else if (y < 8) nav.classList.remove("is-compact");
    if (!menuOpen && !nav.contains(document.activeElement)) {
      if (y > lastY + 4 && y > 240) nav.classList.add("is-hidden");
      else if (y < lastY - 4 || y <= 240) nav.classList.remove("is-hidden");
    }
    lastY = y;

    const max = document.documentElement.scrollHeight - window.innerHeight;
    nav.style.setProperty("--progress", String(max > 0 ? Math.min(1, y / max) : 0));

    if (sections.length) {
      const probe = window.innerHeight * 0.35;
      let current: HTMLAnchorElement | null = pageLink;
      for (const { link, section } of sections) {
        if (section.getBoundingClientRect().top <= probe) current = link;
      }
      if (current !== active) {
        active = current;
        moveIndicator(active);
      }
    }
  }

  // Keep the spacer exactly as tall as the full bar, whatever fonts load.
  const spacer = document.querySelector<HTMLElement>(".nav-spacer");
  function sizeSpacer() {
    if (nav && spacer && !nav.classList.contains("is-compact")) spacer.style.height = `${nav.offsetHeight}px`;
  }

  if (nav) {
    nav.classList.add("has-indicator");
    moveIndicator(active);
    sizeSpacer();
    update();
    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener("resize", () => {
      moveIndicator(active);
      sizeSpacer();
    });
    document.fonts?.ready.then(() => {
      moveIndicator(active);
      sizeSpacer();
    });
    // Keyboard users tabbing into a hidden bar get it back.
    nav.addEventListener("focusin", () => nav.classList.remove("is-hidden"));
  }
</script>

<style>
  /*
   * Fixed, not sticky: the bar changes height when it turns compact, and a
   * sticky bar would push the page by that amount right at the top of the
   * page, which flips it back and makes it jitter. The spacer below holds the
   * bar's full height in the page flow instead.
   */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: var(--spacing-4) clamp(var(--spacing-4), 5.5vw, 80px) 0;
    /* A black bar, like a manga panel border. Only the bar takes the dark
       theme; the full-screen phone menu stays light. */
    background: var(--color-ink-1000);
    transition:
      translate var(--motion-duration-slow) var(--motion-ease-out),
      padding var(--motion-duration-base) var(--motion-ease-out);
  }

  /* Full (not compact) bar height: 16px top + 48px logo + 16px + 2px rule. */
  .nav-spacer {
    height: 82px;
  }

  /* Scrolling down slides the bar away; scrolling up brings it back. It stops
     short by the progress line's height, so that line (which sits flush with
     the bar's bottom edge) stays pinned to the top of the screen. */
  .nav.is-hidden {
    translate: 0 calc(-100% + var(--border-heavy));
  }

  .nav.is-compact {
    padding-top: var(--spacing-2);
  }

  /* The bar takes the dark theme's tokens, but text inherits its colour as
     already worked out on the light page, so it must be set again here, or
     anything without a colour of its own (the tagline) stays black on black. */
  .nav__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--spacing-8);
    padding-bottom: var(--spacing-4);
    border-bottom: var(--border-thin) solid var(--color-border-default);
    color: var(--color-text-primary);
    transition: padding var(--motion-duration-base) var(--motion-ease-out);
  }

  .is-compact .nav__bar {
    padding-bottom: var(--spacing-2);
  }

  .nav__wordmark :global(svg) {
    width: auto;
    height: 48px;
    transition: height var(--motion-duration-base) var(--motion-ease-out);
  }

  .is-compact .nav__wordmark :global(svg) {
    height: 36px;
  }

  :global(.nav__spark) {
    transition: rotate var(--motion-duration-slow) var(--motion-ease-snap);
  }

  .is-compact :global(.nav__spark) {
    rotate: 90deg;
  }

  /* Reading progress along the bottom edge. */
  .nav__progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(-1 * var(--border-thin));
    height: var(--border-heavy);
    background: var(--color-bg-primary);
    transform-origin: left center;
    scale: var(--progress, 0) 1;
  }

  .nav__home {
    display: flex;
    color: var(--color-text-primary);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--spacing-6);
  }

  .nav__links ul {
    position: relative;
    display: flex;
    gap: var(--spacing-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    position: relative;
    display: block;
    padding: var(--spacing-2) var(--spacing-3);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color var(--motion-duration-fast) var(--motion-ease-out);
  }

  /* The ink block that slides to the active link. Without JS the current
     page's link gets the same look directly. */
  .nav__indicator {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: var(--color-bg-primary);
    opacity: 0;
    transition:
      translate var(--motion-duration-slow) var(--motion-ease-snap),
      width var(--motion-duration-slow) var(--motion-ease-snap),
      opacity var(--motion-duration-fast) var(--motion-ease-out);
  }

  .nav__link.is-active {
    color: var(--color-text-on-primary);
  }

  .nav:not(.has-indicator) .nav__link[aria-current="page"] {
    background: var(--color-bg-primary);
    color: var(--color-text-on-primary);
  }

  @media (hover: hover) {
    .nav__link:not(.is-active):hover {
      text-decoration: underline;
      text-decoration-thickness: var(--border-thin);
      text-underline-offset: 6px;
      text-decoration-color: var(--color-border-primary);
    }
  }

  .nav__tagline {
    margin-left: auto;
    text-align: right;
  }

  .nav__icon,
  .nav__toggle {
    display: none;
  }

  .nav__toggle,
  .menu__close {
    display: none;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-2) var(--spacing-3);
    border: var(--border-regular) solid var(--color-border-default);
    border-radius: var(--radius-none);
    background: var(--color-bg-page);
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .menu__close {
    display: flex;
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  /* Full-screen mobile menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background: var(--color-bg-page);
  }

  .menu[hidden] {
    display: none;
  }

  /* The slanted black stripe that leads the menu's sweep. Clipped to nothing
     except while the menu opens or closes. */
  .menu__ink {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--color-ink-1000);
    clip-path: polygon(0 0, 0 0, 0 0, 0 0);
    pointer-events: none;
  }

  .menu__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-3) var(--spacing-4);
    border-bottom: var(--border-heavy) solid var(--color-border-default);
  }

  .menu__links {
    margin: 0;
    padding: var(--spacing-6) var(--spacing-4) 0;
    list-style: none;
  }

  .menu__link {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    padding: var(--spacing-3) 0;
    border-bottom: var(--border-thin) solid var(--color-border-subtle);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .menu__number,
  .menu__link[aria-current="page"] {
    color: var(--color-text-accent);
  }

  .menu__footer {
    display: grid;
    gap: var(--spacing-2);
    padding: var(--spacing-8) var(--spacing-4) var(--spacing-32);
  }

  .menu__tagline {
    color: var(--color-text-secondary);
  }

  .menu__halftone {
    margin-top: auto;
  }

  @media (max-width: 1023px) {
    .nav__tagline {
      display: none;
    }
  }

  @media (max-width: 767px) {
    .nav,
    .nav.is-compact {
      padding: 0;
    }

    .nav__bar {
      justify-content: space-between;
      padding: var(--spacing-3) var(--spacing-4);
      border-bottom-width: var(--border-heavy);
    }

    .is-compact .nav__bar {
      padding-block: var(--spacing-2);
    }

    /* 12px + 40px icon + 12px + 4px rule */
    .nav-spacer {
      height: 68px;
    }

    .nav__progress {
      bottom: calc(-1 * var(--border-heavy));
    }

    .nav__wordmark,
    .nav__links {
      display: none;
    }

    .nav__icon {
      display: block;
    }

    .nav__toggle {
      display: flex;
    }
  }

  :global(.menu-open) {
    overflow: hidden;
  }
</style>
