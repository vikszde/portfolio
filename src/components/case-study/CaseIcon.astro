    "M3 13a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z",
    "M15 9a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1z",
    "M9 5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1z",
    "M4 20h14",
  ],
  refresh: ["M20 11A8.1 8.1 0 0 0 4.5 9M4 5v4h4", "M4 13a8.1 8.1 0 0 0 15.5 2m.5 4v-4h-4"],
} as const;
---

<svg
  class:list={["case-icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {icons[name].map((d) => <path d={d} pathLength="1" />)}
</svg>

<style>
  .case-icon {
    flex-shrink: 0;
  }

  :global(.js [data-reveal]) .case-icon path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(.js [data-reveal].is-visible) .case-icon path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 900ms var(--motion-ease-out) calc(var(--reveal-delay, 0ms) + 250ms);
  }
</style>
