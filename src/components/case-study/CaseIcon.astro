---
// Line icons from the Figma "Icon" set used on case study pages (Tabler
// shapes, 24px grid, 2px stroke). They follow the text colour. Hidden from
// screen readers: always pair an icon with visible text. Inside a scroll
// reveal ([data-reveal]) the strokes draw themselves in as it appears.
interface Props {
  name: keyof typeof icons;
  size?: number;
  class?: string;
}

const { name, size = 32, class: className } = Astro.props;

const icons = {
  "pen-tool": [
    "M3 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z",
    "M17 18a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1z",
    "M7 5h7",
    "M10 19h7",
    "M8 19a1 1 0 1 0 2 0a1 1 0 1 0-2 0",
    "M14 5a1 1 0 1 0 2 0a1 1 0 1 0-2 0",
    "M7 5.5a5 6.5 0 0 1 5 6.5a5 6.5 0 0 0 5 6.5",
  ],
  stack: ["M12 4L4 8l8 4l8-4z", "M4 12l8 4l8-4", "M4 16l8 4l8-4"],
  code: ["M7 8l-4 4l4 4", "M17 8l4 4l-4 4", "M14 4l-4 16"],
  briefcase: [
    "M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z",
    "M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2",
    "M12 12v.01",
    "M3 13a20 20 0 0 0 18 0",
  ],
  home: ["M5 12H3l9-9l9 9h-2", "M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7", "M9 21v-6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v6"],
  key: [
    "M16.555 3.843l3.602 3.602a2.877 2.877 0 0 1 0 4.069l-2.643 2.643a2.877 2.877 0 0 1-4.069 0l-.301-.301l-6.558 6.558a2 2 0 0 1-1.239.578L5.172 21H4a1 1 0 0 1-.993-.883L3 20v-1.172a2 2 0 0 1 .467-1.284l.119-.13L4 17h2v-2h2v-2l2.144-2.144l-.301-.301a2.877 2.877 0 0 1 0-4.069l2.643-2.643a2.877 2.877 0 0 1 4.069 0z",
    "M15 9h.01",
  ],
  search: ["M3 10a7 7 0 1 0 14 0a7 7 0 1 0-14 0", "M21 21l-6-6"],
  bookmark: ["M18 7v14l-6-4l-6 4V7a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4z"],
  compare: [
    "M4 6a2 2 0 1 0 4 0a2 2 0 1 0-4 0",
    "M16 18a2 2 0 1 0 4 0a2 2 0 1 0-4 0",
    "M11 6h5a2 2 0 0 1 2 2v8",
    "M14 9l-3-3l3-3",
    "M13 18H8a2 2 0 0 1-2-2V8",
    "M10 15l3 3l-3 3",
  ],
  users: [
    "M5 7a4 4 0 1 0 8 0a4 4 0 1 0-8 0",
    "M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2",
    "M16 3.13a4 4 0 0 1 0 7.75",
    "M21 21v-2a4 4 0 0 0-3-3.85",
  ],
  checklist: ["M9.615 20H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8", "M14 19l2 2l4-4", "M9 8h4", "M9 12h2"],
