---
// A full page shown inside a device: a laptop or a phone whose screen scrolls
// on its own, so a long design can be read top to bottom without leaving the
// case study. The screen is a focusable region, so keyboard users can scroll
// it with the arrow keys too. Use it only for complete pages; crops of part
// of a screen stay in <Shot>.
//
// The first time a screen comes into view it "peeks": it scrolls a little way
// down and back, to show there is more page inside. `reveal` sets the scroll
// reveal variant ("" is the default rise; false turns it off).
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  device?: "laptop" | "phone";
  caption?: string;
  sizes?: string;
  reveal?: string | false;
  class?: string;
}

const { src, alt, device = "laptop", caption, sizes, reveal = "", class: className } = Astro.props;
const widths = device === "phone" ? [400, src.width * 2 > 800 ? 800 : src.width] : [600, 1000, src.width];
const unique = [...new Set(widths.filter((w) => w <= src.width))];
---

<figure class:list={["device", `device--${device}`, className]} data-reveal={reveal === false ? undefined : reveal}>
  <div class="device__body">
    <div class="device__screen" tabindex="0" role="region" aria-label={`${alt} Scrollable.`} data-device-screen>
      <Image {src} {alt} widths={unique} sizes={sizes ?? (device === "phone" ? "220px" : "(min-width: 1100px) 470px, (min-width: 768px) 45vw, 88vw")} format="webp" loading="lazy" />
    </div>
    <span class="device__hint text-label-s" aria-hidden="true">Scroll ↕</span>
  </div>
  {device === "laptop" && <span class="device__base" aria-hidden="true"></span>}
  {caption && <figcaption class="text-body-m device__caption">{caption}</figcaption>}
</figure>

<script>
  const stillMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));

  document.querySelectorAll<HTMLElement>("[data-device-screen]").forEach((screen) => {
    let peeking = false;
    let touched = false;

    // The "Scroll" hint fades once the visitor has scrolled the screen
    // themselves; the peek below doesn't count.
    screen.addEventListener(
      "scroll",
      () => {
        if (!peeking && screen.scrollTop > 24) screen.parentElement?.classList.add("is-scrolled");
      },
      { passive: true },
    );

    // Any input means the visitor has taken over: stop peeking.
    for (const type of ["wheel", "touchstart", "pointerdown", "keydown"]) {
      screen.addEventListener(type, () => (touched = true), { passive: true });
    }

    if (stillMotion || !("IntersectionObserver" in window)) return;

    const peek = async () => {
      const room = screen.scrollHeight - screen.clientHeight;
      if (room < 40 || touched) return;
      peeking = true;
      await wait(700);
      if (!touched) screen.scrollTo({ top: Math.min(room, screen.clientHeight * 0.8), behavior: "smooth" });
      await wait(1300);
      if (!touched) screen.scrollTo({ top: 0, behavior: "smooth" });
      await wait(900);
      peeking = false;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        peek();
      },
      { threshold: 0.75 },
    );
    observer.observe(screen);
  });
</script>

<style>
  .device {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0;
    min-width: 0;
  }

  .device__body {
    position: relative;
    width: 100%;
    border: var(--border-heavy) solid var(--color-border-default);
    background: var(--color-ink-1000);
  }

  .device__screen {
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--color-aqua-500) var(--color-ink-900);
    background: var(--color-ink-1000);
  }

  .device__screen img {
    display: block;
    width: 100%;
    height: auto;
  }

  .device__screen:focus-visible {
    outline: var(--border-regular) solid var(--color-border-primary);
    outline-offset: -3px;
  }

  /* Laptop: a dark bezel around a 16:10 screen, with a flat base under it.
     The base overhangs the lid a little but stays inside the column, so two
     laptops side by side never touch. */
  .device--laptop .device__body {
    width: 94%;
    padding: 8px 8px 12px;
    border-radius: 10px 10px 0 0;
  }

  .device--laptop .device__screen {
    aspect-ratio: 16 / 10;
  }

  .device__base {
    display: block;
    width: 100%;
    height: 12px;
    border: var(--border-heavy) solid var(--color-border-default);
    border-top-width: var(--border-thin);
    border-radius: 0 0 12px 12px;
    background: var(--color-ink-700);
  }

  /* Phone: rounded body and a screen at the iPhone design ratio (393 × 852). */
  .device--phone .device__body {
    padding: 8px;
    border-radius: 30px;
  }

  .device--phone .device__screen {
    aspect-ratio: 393 / 852;
    border-radius: 22px;
  }

  .device--phone .device__body::before {
    content: "";
    position: absolute;
    top: 15px;
    left: 50%;
    z-index: 1;
    width: 30%;
    height: 16px;
    border-radius: var(--radius-full);
    background: var(--color-ink-1000);
    translate: -50% 0;
  }

  .device__hint {
    position: absolute;
    right: 18px;
    bottom: 22px;
    padding: 2px var(--spacing-2);
    border: var(--border-thin) solid var(--color-ink-1000);
    background: var(--color-bg-secondary);
    color: var(--color-ink-1000);
    pointer-events: none;
    transition: opacity var(--motion-duration-base) var(--motion-ease-out);
  }

  .device--phone .device__hint {
    right: 50%;
    bottom: 20px;
    translate: 50% 0;
  }

  .is-scrolled .device__hint {
    opacity: 0;
  }

  .device__caption {
    justify-self: stretch;
    margin-top: var(--spacing-3);
    color: var(--color-text-secondary);
  }

  .device--laptop .device__caption {
    margin-top: var(--spacing-4);
  }

  @media (max-width: 767px) {
    .device--laptop .device__body {
      padding: 6px 6px 10px;
    }

    /* A taller screen on phones shows more of the page at once. */
    .device--laptop .device__screen {
      aspect-ratio: 4 / 3;
    }

    .device__hint {
      right: 14px;
      bottom: 18px;
      padding: 2px 6px;
      font-size: 0.625rem;
      line-height: 0.875rem;
    }

    .device--phone .device__hint {
      bottom: 18px;
    }
  }
</style>
