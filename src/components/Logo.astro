const { viewBox, ink, pink } = art[variant];
const [, , w, h] = viewBox.split(" ").map(Number);
---

<svg
  class:list={["logo", className]}
  viewBox={viewBox}
  height={height}
  width={Math.round((height * w) / h)}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  {ink.map((d) => <path d={d} fill="currentColor" />)}
  {pink.map((d) => <path d={d} class="logo__pink" />)}
</svg>

<style>
  .logo {
    display: block;
    flex-shrink: 0;
    color: var(--color-text-primary);
  }

  .logo__pink {
    fill: var(--color-bg-primary);
  }
</style>
