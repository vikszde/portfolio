const mark = marks[tool];
---

<Tag class:list={["tool", className]} {...rest}>
  <span class="tool__box">
    <svg viewBox={mark.viewBox} aria-hidden="true" focusable="false">
      {mark.paths.map(([d, fill]) => <path d={d} fill={fill} />)}
    </svg>
  </span>
  <span class="tool__label text-label-m">{mark.label}</span>
  {learning && <Pill color="yellow" class="tool__learning">Learning</Pill>}
</Tag>

<style>
  .tool {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    list-style: none;
  }

  /* After the label in reading order ("Rive, Learning"), drawn as a tilted
     tag over the box's top-right corner. */
  .tool :global(.tool__learning) {
    position: absolute;
    top: calc(var(--spacing-3) * -1);
    right: calc(var(--spacing-4) * -1);
    rotate: 8deg;
  }

  .tool__box {
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    border: var(--border-thin) solid var(--color-border-accent);
    border-radius: var(--radius-sm);
    color: var(--color-text-primary);
    transition:
      background var(--motion-duration-fast) var(--motion-ease-out),
      border-color var(--motion-duration-fast) var(--motion-ease-out);
  }

  .tool__box svg {
    width: 40px;
    height: 40px;
  }

  .tool__label {
    text-transform: none;
    letter-spacing: 0;
  }

  @media (hover: hover) {
    .tool:hover .tool__box {
      border-color: var(--color-border-primary);
      background: var(--color-bg-accent-subtle);
    }
  }

  @media (max-width: 767px) {
    .tool__box {
      width: 72px;
      height: 72px;
    }

    .tool__box svg {
      width: 32px;
      height: 32px;
    }
  }
</style>
