    <svg class="intro__spin" viewBox="102.096 0 70 84" width="83.3" height="100">
      <path class="intro__pink" d="M172.096 42C157.338 44.0937 149.46 45.7388 144.836 51.2879C140.212 56.837 138.841 66.2902 137.096 84C135.351 66.2902 133.98 56.837 129.356 51.2879C124.732 45.7389 116.854 44.0937 102.096 42C116.854 39.9063 124.732 38.2612 129.356 32.7121C133.98 27.163 135.351 17.7098 137.096 0C138.841 17.7098 140.212 27.163 144.836 32.7121C149.46 38.2611 157.338 39.9063 172.096 42Z"></path>
    </svg>
