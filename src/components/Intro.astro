---
// Full-screen logo intro for the home page, from the Figma "Logo" page. On a
// black screen the logo icon spins in and turns into "logo 01 inverse": its
// orbit becomes the logo's orbit, its sparkle travels onto the V and the
// letters unfold around it. The extras then peel away, leaving the plain
// wordmark, which flies into the nav while the black screen shrinks up into
// the nav bar. On phones, where the nav shows the icon, the wordmark fades
// out over it instead.
//
// It plays once per browser session, never with reduced motion or when the
// page opens at a #section, and any click, tap, key or wheel skips it.
// Place it before <Nav /> so the screen is up before the first paint.
---

<script is:inline>
  try {
    if (
      !sessionStorage.getItem("intro-seen") &&
      !matchMedia("(prefers-reduced-motion: reduce)").matches &&
      !location.hash
    ) {
      sessionStorage.setItem("intro-seen", "1");
      // is-intro holds the page; is-intro-logo hides the nav logo until the
      // flying one has landed on it.
      document.documentElement.classList.add("is-intro", "is-intro-logo");
      // Safety net if the intro's script never runs: let the page go.
      setTimeout(() => {
        const html = document.documentElement;
        if (!html.classList.contains("is-intro-logo")) return;
        html.classList.remove("is-intro", "is-intro-logo");
        document.dispatchEvent(new CustomEvent("intro:handoff"));
      }, 8000);
    }
  } catch {}
</script>

