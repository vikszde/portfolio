<script>
  /*
   * The timeline, in ms. The icon spins in and holds until E, when it starts
   * turning into logo 01. Logo 01 holds until S, when the extras peel away,
   * leaving the plain wordmark. F to FE: the wordmark flies into the nav and
   * the screen shrinks into the nav bar. The page starts its own entrance
   * (hero text, the character's intro) at F.
   */
  const E = 1400;
  const S = E + 1400;
  const F = S + 450;
  const FE = F + 650;
  const END = FE + 250;

  const ease = {
    out: "cubic-bezier(0.2, 0.8, 0.2, 1)",
    back: "cubic-bezier(0.34, 1.56, 0.64, 1)",
    in: "cubic-bezier(0.6, 0, 0.8, 0.4)",
    inOut: "cubic-bezier(0.65, 0, 0.35, 1)",
  };

  type Props = Record<string, string | number>;
  type Frame = [at: number, props: Props, easing?: string];
  type Box = { x: number; y: number; h: number };

  const html = document.documentElement;

  function handOff() {
    if (!html.classList.contains("is-intro")) return;
    html.classList.remove("is-intro");
    document.dispatchEvent(new CustomEvent("intro:handoff"));
  }

  function finish(screen: HTMLElement) {
    handOff();
    screen.remove();
    html.classList.remove("is-intro-logo");
  }

  // Places a part drawn `base` px tall so it is h px tall with its top left
  // at x, y.
  const pose = ({ x, y, h }: Box, base: number) => ({ transform: `translate(${x}px, ${y}px) scale(${h / base})` });

  // Draws a part's SVG at `base` px tall. Each part is drawn at the largest
  // size it reaches and only ever scaled down, so it stays sharp while the
  // browser moves it as a ready-made picture.
  function drawAt(part: Element, base: number) {
    const svg = part.querySelector("svg")!;
    const [, , w, h] = svg.getAttribute("viewBox")!.split(" ").map(Number);
    svg.setAttribute("height", String(base));
    svg.setAttribute("width", String((base * w) / h));
  }

  function play(screen: HTMLElement) {
    const part = (name: string) => screen.querySelector<SVGElement | HTMLElement>(`[data-part="${name}"]`)!;
    const icon = part("icon");
    const logo = part("logo");
    const sparkle = part("sparkle");
    const letters = [...screen.querySelectorAll<SVGPathElement>("[data-letter]")];
    const dots = [...screen.querySelectorAll<SVGCircleElement>("[data-dot]")];

    // The nav's wordmark, or on phones the nav's icon.
    const wordmark = document.querySelector<SVGSVGElement>(".nav__wordmark svg");
    const navIcon = document.querySelector<SVGSVGElement>(".nav__icon svg");
    const onPhone = !wordmark?.getClientRects().length;
    const target = (onPhone ? navIcon : wordmark)?.getBoundingClientRect();
    const navBottom = document.querySelector("[data-nav]")?.getBoundingClientRect().bottom ?? 0;
    if (!target) return finish(screen);

    // Logo 01, centred. The icon sits where its orbit matches the logo's
    // orbit (centre 274, 115 in logo units; 143, 185.4 in icon units, at 0.85
    // of the size), so the ring seems to stay put while the rest changes.
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const u = Math.min(Math.min(vw * 0.7, 560) / 581, (vh * 0.32) / 236);
    const iu = u * 0.85;
    const L = { x: (vw - 581 * u) / 2, y: (vh - 236 * u) / 2, h: 236 * u };
    const I = { x: L.x + 274 * u - 143 * iu, y: L.y + 115 * u - 185.4 * iu, h: 357 * iu };
    // In the nav the wordmark's letters line up with logo 01's, unit for unit.
    const N = { x: target.left, y: target.top, h: target.height };
    const un = N.h / 236;
    const sparkleOn = {
      icon: { x: I.x + 67.79 * iu, y: I.y, h: 134.35 * iu },
      logo: { x: L.x + 102.1 * u, y: L.y, h: 84 * u },
      nav: { x: N.x + 102.1 * un, y: N.y, h: 84 * un },
    };

    // The letters unfold from the middle of the word outwards.
    const fromCentre = letters
      .map((el, i) => {
        const box = el.getBBox();
        return { i, d: Math.abs(box.x + box.width / 2 - 274) };
      })
      .sort((a, b) => a.d - b.d)
      .map(({ i }) => i);

    drawAt(icon, I.h);
    drawAt(logo, L.h);
    drawAt(sparkle, sparkleOn.icon.h);
    const iconAt = (b: Box) => pose(b, I.h);
    const logoAt = (b: Box) => pose(b, L.h);
    const sparkleAt = (b: Box) => pose(b, sparkleOn.icon.h);

    const flyOut = onPhone ? { opacity: 0 } : {};
    const tracks: [Element, Frame[]][] = [
      [icon, [[0, { ...iconAt(I), opacity: 1 }], [E + 550, { opacity: 1 }], [E + 600, { opacity: 0 }]]],
      [icon.firstElementChild!, [[0, { transform: "scale(0) rotate(-270deg)" }, ease.out], [800, { transform: "scale(1) rotate(0deg)" }]]],
      [part("icon-ink"), [[E, { opacity: 1, transform: "scale(1)" }, ease.in], [E + 400, { opacity: 0, transform: "scale(0.4)" }]]],
      [part("icon-slash"), [[E, { opacity: 1, transform: "scale(1) rotate(0deg)" }, ease.in], [E + 350, { opacity: 0, transform: "scale(0.2) rotate(40deg)" }]]],
      [part("icon-dots"), [[E, { opacity: 1 }], [E + 300, { opacity: 0 }]]],
      [part("icon-orbit"), [[E + 200, { opacity: 1 }], [E + 600, { opacity: 0 }]]],

      [sparkle, [[E, { ...sparkleAt(sparkleOn.icon), opacity: 1 }, ease.inOut], [E + 700, sparkleAt(sparkleOn.logo)], [F, { ...sparkleAt(sparkleOn.logo), opacity: 1 }, ease.inOut], [FE, { ...sparkleAt(sparkleOn.nav), ...flyOut }]]],
      // It spins in with the icon, then turns half a turn on its way to the V.
      [sparkle.firstElementChild!, [[0, { transform: "scale(0) rotate(-270deg)" }, ease.out], [800, { transform: "scale(1) rotate(0deg)" }], [E, { transform: "scale(1) rotate(0deg)" }, ease.inOut], [E + 700, { transform: "scale(1) rotate(180deg)" }]]],

      [logo, [[F, { ...logoAt(L), opacity: 1 }, ease.inOut], [FE, { ...logoAt(N), ...flyOut }]]],
      [part("logo-orbit"), [[E + 200, { opacity: 0, transform: "rotate(-35deg)" }, ease.out], [E + 650, { opacity: 1, transform: "rotate(0deg)" }], [S, { opacity: 1, transform: "rotate(0deg)" }, ease.in], [S + 400, { opacity: 0, transform: "rotate(70deg)" }]]],
      ...letters.map((el, i): [Element, Frame[]] => {
        const at = E + 200 + fromCentre.indexOf(i) * 60;
        return [el, [[at, { transform: "scaleX(0)" }, ease.back], [at + 420, { transform: "scaleX(1)" }]]];
      }),
      [part("logo-underline"), [[E + 500, { transform: "scaleX(0)" }, ease.out], [E + 800, { transform: "scaleX(1)" }], [S, { transform: "scaleX(1)" }, ease.in], [S + 300, { transform: "scaleX(0)" }]]],
      [part("logo-spark"), [[E + 600, { transform: "scale(0) rotate(0deg)" }, ease.back], [E + 850, { transform: "scale(1) rotate(90deg)" }], [S + 50, { transform: "scale(1) rotate(90deg)" }, ease.in], [S + 330, { transform: "scale(0) rotate(180deg)" }]]],
      ...dots.map((el, i): [Element, Frame[]] => [
        el,
        [[E + 650 + i * 60, { transform: "scale(0)" }, ease.back], [E + 870 + i * 60, { transform: "scale(1)" }], [S + i * 50, { transform: "scale(1)" }, ease.in], [S + 220 + i * 50, { transform: "scale(0)" }]],
      ]),

      // The black shrinks up until it is exactly the nav bar, then the
      // screen fades so the nav's links show through. Kept last: when it
      // ends, the intro is over.
      [part("bg"), [[F, { transform: "scaleY(1)" }, ease.inOut], [FE, { transform: `scaleY(${navBottom / vh})` }]]],
      [screen, [[FE + 20, { opacity: 1 }], [END, { opacity: 0 }]]],
    ];

    const animations = tracks.map(([el, frames]) => run(el, frames));
    animations.forEach((a) => a.pause());
    let handOffTimer = 0;
    animations.at(-1)!.finished.then(() => finish(screen)).catch(() => {});

    // While the page is still loading, frames come late and the icon's spin
    // would be over before it is ever drawn. The clock starts once two frames
    // in a row arrive on time (or after a second at most).
    const begin = () => {
      if (handOffTimer) return;
      animations.forEach((a) => a.play());
      handOffTimer = window.setTimeout(handOff, F);
    };
    let last = performance.now();
    let smooth = 0;
    const tick = (now: number) => {
      smooth = now - last < 34 ? smooth + 1 : 0;
      last = now;
      if (smooth >= 2) begin();
      else if (!handOffTimer) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
    setTimeout(begin, 1000);

    // Any input skips to the end.
    const skip = () => {
      clearTimeout(handOffTimer);
      handOffTimer = -1;
      animations.forEach((a) => a.finish());
      for (const type of ["pointerdown", "keydown", "wheel", "touchstart"]) window.removeEventListener(type, skip);
    };
    for (const type of ["pointerdown", "keydown", "wheel", "touchstart"]) window.addEventListener(type, skip, { passive: true });
  }

  // One animation per element, running only between its first and last
  // frame, so parts that have settled stop costing the browser anything.
  // Every property holds its first value until its first frame and its last
  // value after.
  function run(el: Element, frames: Frame[]) {
    const from = frames[0][0];
    const span = frames[frames.length - 1][0] - from || 1;
    const first: Props = {};
    const last: Props = {};
    for (const [, props] of frames) {
      for (const key in props) {
        if (!(key in first)) first[key] = props[key];
        last[key] = props[key];
      }
    }
    const keyframes: Keyframe[] = [
      { offset: 0, ...first },
      ...frames.map(([at, props, easing]) => ({ offset: (at - from) / span, ...props, ...(easing ? { easing } : {}) })),
      { offset: 1, ...last },
    ];
    return el.animate(keyframes, { delay: from, duration: span, fill: "both" });
  }

  // A reload that lands part-way down the page skips the intro, and so does
  // anything going wrong: the page must never stay held under the screen.
  const screen = document.querySelector<HTMLElement>("[data-intro]");
  if (screen && html.classList.contains("is-intro")) {
    try {
      if (window.scrollY > 0) finish(screen);
      else play(screen);
    } catch {
      finish(screen);
    }
  }
</script>

<style>
  /* Shown only while <html> has .is-intro-logo (set by the inline script
     above), so without JavaScript or on later visits it never appears. */
  .intro-screen {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 200;
    overflow: hidden;
    color: var(--color-paper-100);
    cursor: pointer;
  }

  .intro__bg {
    position: absolute;
    inset: 0;
    background: var(--color-ink-1000);
    transform-origin: 50% 0;
    will-change: transform;
  }

  :global(.is-intro-logo) .intro-screen {
    display: block;
  }

  /* The page holds still under the screen: no scrolling, and it isn't drawn
     or animated, so the browser spends every frame on the intro. */
  :global(html.is-intro) {
    overflow: hidden;
  }

  :global(html.is-intro main),
  :global(html.is-intro footer) {
    visibility: hidden;
  }

  :global(html.is-intro main *) {
    animation-play-state: paused !important;
  }

  /* The real nav logo waits for the flying one to land on it. */
  :global(.nav__home) {
    transition: opacity 200ms ease-out;
  }

  :global(.is-intro-logo .nav__home) {
    opacity: 0;
  }

  /* Hidden until the script places them: before it runs they would sit at
     full size in the top left corner. Each part's animation sets its own
     opacity from the first frame. */
  .intro__part {
    position: absolute;
    top: 0;
    left: 0;
    transform-origin: 0 0;
    opacity: 0;
    will-change: transform, opacity;
  }

  .intro__part svg {
    display: block;
    overflow: visible;
    fill: currentColor;
  }

  .intro__spin {
    transform-origin: 50% 50%;
  }

  .intro__part path,
  .intro__part circle,
  .intro__part g {
    transform-box: fill-box;
    transform-origin: 50% 50%;
