---
// Project card from the Figma "Project card" set: a slightly skewed paper
// cut-out with a number tab, cover, condensed title, one arrow box and
// hashtag tags. The whole card is the link. `shape` picks one of three paper
// outlines and `tilt` rotates the card a little so a row looks hand-placed.
import Halftone from "./Halftone.astro";

interface Props {
  number: string;
  title: string;
  summary: string;
  tags: string[];
  href: string;
  cover?: string;
  coverAlt?: string;
  shape?: "A" | "B" | "C";
  tilt?: number;
}

const { number, title, summary, tags, href, cover, coverAlt = "", shape = "A", tilt = 0 } = Astro.props;

const outlines = {
  A: "10,26 398,0 400,520 0,510",
  B: "0,6 392,0 400,514 8,520",
  C: "6,0 400,16 394,520 0,506",
};

// The cover is clipped to the same angles as the paper, so the white margin
// around it stays even. Corners as % of the cover box, in TL TR BR BL order,
// derived from the outlines above at the card's usual size; `tab` drops the
// number tab below the cover's sloping top edge.
const covers = {
  A: { clip: "1.7% 8%, 99.7% 0, 100% 100%, 0 97%", tab: "40px" },
  B: { clip: "0 1.8%, 98.7% 0, 100% 98.2%, 1.3% 100%", tab: "20px" },
  C: { clip: "1% 0, 100% 4.9%, 99% 100%, 0 95.7%", tab: "16px" },
};
---

<a class="card" href={href} style={`--tilt: ${tilt}deg; --cover-clip: polygon(${covers[shape].clip}); --tab-top: ${covers[shape].tab}`}>
  <svg class="card__paper" viewBox="0 0 400 520" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <polygon points={outlines[shape]} vector-effect="non-scaling-stroke"></polygon>
  </svg>
  <div class="card__cover">
    <div class="card__media">
      {
        cover ? (
          <img src={cover} alt={coverAlt} loading="lazy" decoding="async" />
        ) : (
          <div class="card__placeholder" aria-hidden="true">
            <Halftone height={140} />
          </div>
        )
      }
    </div>
    <span class="card__number">{number}</span>
  </div>
  <div class="card__body">
    <div class="card__title-row">
      <h3 class="card__title" style={`--chars: ${title.length}`}>{title}</h3>
      <span class="card__arrow" aria-hidden="true">↗</span>
    </div>
    <p class="card__summary text-body-m">{summary}</p>
    <p class="card__tags text-label-s">
      {tags.map((tag, i) => <span>{i > 0 && <span class="card__dot" aria-hidden="true">·</span>}# {tag}</span>)}
    </p>
  </div>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    /* An even 16px of paper around the cover; the cover's clip follows the
       paper's slopes, so this margin holds along every edge. */
    padding: 16px 16px 20px;
    color: var(--color-text-primary);
    text-decoration: none;
    rotate: var(--tilt);
    transition:
      rotate var(--motion-duration-base) var(--motion-ease-snap),
      translate var(--motion-duration-base) var(--motion-ease-snap);
  }

  .card__paper {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .card__paper polygon {
    fill: var(--color-bg-surface);
    stroke: var(--color-border-default);
    stroke-width: 2.5;
    stroke-linejoin: miter;
  }

  .card__cover {
    position: relative;
    aspect-ratio: 372 / 330;
  }

  .card__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--color-bg-accent-subtle);
    clip-path: var(--cover-clip);
  }

  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .card__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
  }

  .card__number {
    position: absolute;
    top: var(--tab-top);
    left: 16px;
    padding: 8px 14px;
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    font: 700 1.125rem / 1 var(--font-sans);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 10px 0;
  }

  .card__title-row {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
    container-type: inline-size;
  }

  /* A one-word title can't wrap, so on a narrow card it shrinks to fit
     beside the arrow box (52px + the gap): Anton runs about 0.42em a letter.
     A row of cards can set --title-chars to its longest title, so all of
     its titles share one size. */
  .card__title {
    flex: 1;
    min-width: 0;
    font: 400 2.25rem / 1.05 var(--font-display);
    font-size: min(2.25rem, calc((100cqi - 52px - var(--spacing-4)) / (var(--title-chars, var(--chars, 8)) * 0.42)));
  }

  .card__arrow {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border: 2.5px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    background: var(--color-bg-surface);
    font: 700 1.625rem / 1 var(--font-sans);
    transition:
      background var(--motion-duration-fast) var(--motion-ease-out),
      color var(--motion-duration-fast) var(--motion-ease-out),
      border-color var(--motion-duration-fast) var(--motion-ease-out);
  }

  .card__summary {
    color: var(--color-text-secondary);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--spacing-2);
  }

  .card__dot {
    margin-right: var(--spacing-2);
    color: var(--color-text-accent);
  }

  /* Hover lifts and straightens the card. A page can also set .is-focus on
     the card's wrapper (the landing page does, on touch screens, while the
     card is centred). */
  @media (hover: hover) {
    .card:hover {
      rotate: 0deg;
      translate: 0 -6px;
    }

    .card:hover .card__arrow {
      background: var(--color-bg-primary);
      border-color: var(--color-border-primary);
      color: var(--color-text-on-primary);
    }
  }

  :global(.is-focus) > .card {
    rotate: 0deg;
    translate: 0 -6px;
  }

  :global(.is-focus) > .card .card__arrow {
    background: var(--color-bg-primary);
    border-color: var(--color-border-primary);
    color: var(--color-text-on-primary);
  }

  /* Touch screens: a tap squishes the card a little before it opens. */
  @media (hover: none) {
    .card {
      transition:
        rotate var(--motion-duration-base) var(--motion-ease-snap),
        translate var(--motion-duration-base) var(--motion-ease-snap),
        scale 120ms var(--motion-ease-out);
    }

    .card:active {
      scale: 0.96;
    }
  }

  .card:focus-visible {
    outline-offset: 6px;
  }

  .card:focus-visible .card__arrow {
    background: var(--color-bg-primary);
    border-color: var(--color-border-primary);
    color: var(--color-text-on-primary);
  }
</style>
