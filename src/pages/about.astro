---
// Placeholder until the full About page is designed.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Button from "../components/Button.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Base title="About · Viktória Varga">
  <Nav current="About" />
  <main class="soon">
    <p class="text-label-m accent">About</p>
    <h1 class="text-display-l">More soon</h1>
    <p class="text-body-l">A longer story about me, my process and my tools is on its way.</p>
    <Button variant="ghost" href={`${base}#about`}>← Back</Button>
  </main>
</Base>

<style>
  .soon {
    display: grid;
    justify-items: start;
    gap: var(--spacing-6);
    padding: var(--spacing-24) var(--gutter);
  }

  .accent {
    color: var(--color-text-accent);
  }
</style>
