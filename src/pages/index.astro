<script>
  import { afterIntro } from "../scripts/after-intro";

  const stillMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Hero speech bubble: types a line, holds it, deletes it, types the next.
  // With reduced motion it just keeps the first line.
  const typing = document.querySelector<HTMLElement>("[data-typing]");
  if (typing && !stillMotion) {
    const lines = ["Hi, I’m Viki.", "I solve problems.", "I design systems.", "I make them visual."];
    let line = 0;
    let shown = lines[0].length;
    let deleting = false;
    const step = () => {
      const text = lines[line];
      if (!deleting && shown === text.length) {
        deleting = true;
        return setTimeout(step, 1600);
      }
      if (deleting && shown === 0) {
        deleting = false;
        line = (line + 1) % lines.length;
        return setTimeout(step, 250);
      }
      shown += deleting ? -1 : 1;
      typing.textContent = lines[line].slice(0, shown);
      setTimeout(step, deleting ? 35 : 75);
    };
    afterIntro(() => setTimeout(step, 2500));
  }

  // Hover effects (project cards, the About photo pile, the comic panels)
  // hang off .is-focus. With a mouse it follows hover and keyboard focus; on
  // touch screens, which can't hover, an element gets it while it sits in the
  // middle band of the screen, so the effect plays as you scroll past.
  const focusables = document.querySelectorAll<Element>("[data-focus]");
  const setFocus = (el: Element, on: boolean) => el.classList.toggle("is-focus", on);
  if (window.matchMedia("(hover: hover)").matches) {
    focusables.forEach((el) => {
      el.addEventListener("pointerenter", () => setFocus(el, true));
      el.addEventListener("pointerleave", () => setFocus(el, false));
      el.addEventListener("focusin", () => setFocus(el, true));
      el.addEventListener("focusout", () => setFocus(el, false));
    });
  } else {
    const centre = new IntersectionObserver(
      (entries) => entries.forEach((entry) => setFocus(entry.target, entry.isIntersecting)),
      { rootMargin: "-40% 0px -40% 0px" },
    );
    focusables.forEach((el) => centre.observe(el));
  }

  // About stats count up from zero when they scroll into view.
  const stats = document.querySelector<HTMLElement>("[data-count]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (stats && !reduced) {
    const numbers = [...stats.querySelectorAll<HTMLElement>("[data-to]")];
    stats.addEventListener(
      "reveal",
      () => {
        const start = performance.now();
        const duration = 1200;
        const tick = (now: number) => {
          const t = Math.min(1, (now - start) / duration);
          const eased = 1 - Math.pow(1 - t, 3);
          for (const el of numbers) {
            el.textContent = `${Math.round(Number(el.dataset.to) * eased)}${el.dataset.suffix ?? ""}`;
          }
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      },
      { once: true },
    );
  }
</script>

<style>
  main {
    overflow-x: clip;
  }

  section {
    position: relative;
    padding-inline: var(--gutter);
  }

  .accent {
    color: var(--color-text-accent);
  }

  .secondary {
    color: var(--color-text-secondary);
  }

  .pink {
    color: var(--color-bg-primary);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
  }

  /* Decor sits behind content. */
  section > :global(.decor),
  .hero__art > :global(*) {
    position: absolute;
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
    min-height: 820px;
    padding-block: var(--spacing-12);
    overflow: clip;
    /* The art is cut off here, so the cut gets a visible floor line. */
    border-bottom: var(--border-heavy) solid var(--color-border-default);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: start;
    gap: var(--spacing-6);
  }

  .hero__title {
    font: 400 clamp(3.5rem, 8.3vw, 7.5rem) / 0.98 var(--font-display);
    text-transform: uppercase;
  }

  /* Each line is its own mask; the words rise out of it in turn on load.
     The small padding keeps the mask from trimming the glyphs. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding-block: 0.04em;
    margin-block: -0.04em;
  }

  .hero__line > span {
    display: inline-block;
    transform-origin: left bottom;
    animation: line-up 950ms var(--motion-ease-snap) 150ms backwards;
  }

  /* Under the logo intro the title waits, and rises as the intro hands off. */
  :global(.is-intro) .hero__line > span {
    animation-play-state: paused;
  }

  .hero__line:nth-child(2) > span {
    animation-delay: 300ms;
  }

  .hero__line:nth-child(3) > span {
    animation-delay: 450ms;
  }

  /* The character drawing, cropped to her upper body. */
  .hero__character {
    position: absolute;
    aspect-ratio: 832 / 880;
  }

  .hero__character > * {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__character img {
    object-fit: cover;
    object-position: top;
  }

  .hero__scroll-arrow {
    display: inline-block;
    --float: 12px;
    animation: float 1.1s ease-in-out infinite;
  }

  /*
   * Ambient motion settings. The loops themselves live in global.css; these
   * set each piece's own size, speed and offset so nothing moves in unison.
   */
  :global(.hero__orbit) {
    --sway: 3deg;
    --dur: 12s;
  }

  :global(.skills__stripes) {
    --slide: 8px;
    --dur: 3.5s;
  }

  :global(.skills__patch) {
    --breathe: 1.05;
    --dur: 8s;
  }

  :global(.skills__burst) {
    --breathe: 1.05;
    --dur: 7s;
    --delay: 1s;
  }

  :global(.skills__shard) {
    --sway: 7deg;
    --dur: 4s;
  }

  .skills__strip {
    --parallax: 100px;
  }

  .about__panel img {
    --parallax: 16px;
  }

  :global(.contact__spark) {
    --dur: 4s;
  }

  /* The sun in the skyline glows slowly. */
  .contact :global(.decor__sun) {
    transform-box: fill-box;
    transform-origin: center;
    --breathe: 1.14;
    animation: breathe 4s ease-in-out infinite;
  }

  .hero__intro {
    max-width: 560px;
  }

  .hero__scroll {
    margin-top: var(--spacing-12);
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .hero__scroll span {
    font-size: 1.75rem;
    vertical-align: middle;
  }

  .hero__art {
    position: relative;
    z-index: 1;
    align-self: stretch;
    margin-right: calc(-1 * var(--gutter));
    min-height: 680px;
    container-type: inline-size;
  }

  .hero__circle {
    left: 12%;
    top: 12%;
    width: 78%;
    aspect-ratio: 1;
    border: var(--border-heavy) solid var(--color-border-default);
    border-radius: 50%;
    background: var(--color-bg-accent-subtle);
  }

  /* The frame is the circle's box. The character overflows it: her head
     breaks out of the top, and her body runs past the bottom so the cut at
     her belt is always hidden. Below the circle's centre she is clipped to
     the inside of the circle; above it she is shown in full. */
  .hero__frame {
    left: 12%;
    top: 12%;
    width: 78%;
    aspect-ratio: 1;
    container-type: inline-size;
  }

  /* 56.12% is the circle's centre in the character's own box:
     (50% + 15.3%) / 116.35% of the frame. */
  .hero__character {
    left: -5%;
    top: -15.3%;
    width: 110%;
    -webkit-mask:
      linear-gradient(#000 0 0) top / 100% 56.12% no-repeat,
      radial-gradient(circle calc(50cqw - var(--border-heavy)) at 50% 56.12%, #000 99.5%, transparent 100%);
    mask:
      linear-gradient(#000 0 0) top / 100% 56.12% no-repeat,
      radial-gradient(circle calc(50cqw - var(--border-heavy)) at 50% 56.12%, #000 99.5%, transparent 100%);
  }

  /* The ring is always centred on the circle, behind it. The circle's centre
     sits 51% across the art and 12% (of the height) + 39cqw down; the ring's
     box is 108cqw wide and 108 × 180 / 620 = 31.36cqw tall, so its corner is
     half of that back from the centre. Rotation turns it about that centre. */
  :global(.hero__orbit) {
    left: -3cqw;
    top: calc(12% + 39cqw - 15.68cqw);
    width: 108cqw;
    rotate: -14deg;
  }

  /* The character's speech bubble: pink, in the top right corner with its
     tail pointing down at her face, typing a few short lines in turn (see
     the script). */
  .hero__bubble {
    right: 4%;
    top: 3%;
    z-index: 3;
    --reveal-delay: 900ms;
  }

  .hero__bubble-box {
    position: relative;
    /* Room for two lines of the longest text, so the bubble never jumps. */
    box-sizing: content-box;
    width: 12ch;
    height: 2.8em;
    padding: var(--spacing-3) var(--spacing-4);
    border: var(--border-heavy) solid var(--color-ink-900);
    background: var(--color-bg-primary);
    color: var(--color-text-on-primary);
    font: 500 1.05rem / 1.4 var(--font-mono);
    rotate: 3deg;
  }

  .hero__bubble-box::before,
  .hero__bubble-box::after {
    content: "";
    position: absolute;
    border-style: solid;
    border-color: transparent;
  }

  .hero__bubble-box::before {
    left: 16px;
    bottom: -24px;
    border-width: 24px 22px 0 0;
    border-top-color: var(--color-ink-900);
  }

  .hero__bubble-box::after {
    left: 20px;
    bottom: -14px;
    border-width: 15px 13px 0 0;
    border-top-color: var(--color-bg-primary);
  }

  /* A pink heart sticker with a white die-cut edge, beating gently. */
  .hero__heart {
    left: 69%;
    top: 57%;
    width: 15%;
    overflow: visible;
    rotate: -12deg;
    --beat: 1.1;
    --beat-rebound: 0.97;
    --dur: 2.6s;
    --delay: 0.6s;
  }

  .hero__heart path {
    stroke-linejoin: round;
  }

  .hero__heart-edge {
    fill: var(--color-ink-900);
    stroke: var(--color-ink-900);
    stroke-width: 22;
  }

  .hero__heart-cut {
    fill: var(--color-white-1000);
    stroke: var(--color-white-1000);
    stroke-width: 16;
  }

  .hero__heart-face {
    fill: var(--color-bg-primary);
    stroke: var(--color-ink-900);
    stroke-width: 3;
  }

  .hero__bubble-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--color-bg-secondary);
    animation: cursor-blink 0.8s steps(1) infinite;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  /* The floor runs the full width of the hero, behind the art. Stretched
     sideways (with even line widths) so it keeps a low, wide horizon. */
  :global(.hero__grid) {
    left: 0;
    bottom: 0;
    z-index: 0;
    width: 100%;
    height: 240px;
    opacity: 0.4;
    --rung-dur: 3s;
  }

  /* Selected work: two case studies and one big pink arrow with an ink
     outline. The arrow runs in from off the left edge behind the cards and
     its head fills the empty third column. It shoots in from the left when
     the cards come into view, then keeps nudging right. 見て! ("look!") sits
     at the end of the section head. */
  .work {
    padding-block: var(--spacing-24);
  }

  .section-head {
    position: relative;
    display: grid;
    gap: var(--spacing-4);
  }

  .section-head__title {
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }

  .work__look {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    justify-items: end;
    margin: 0;
    font-family: var(--font-jp);
    font-size: 4.5rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-text-primary);
    rotate: -4deg;
  }

  .work__look-word {
    display: flex;
  }

  .work__look-ch {
    display: inline-block;
  }

  /* 見て! slams in a character at a time, manga style, then every few
     seconds the "!" hops and the word gives a startled jolt. */
  :global(.js) .work__look[data-reveal] {
    opacity: 1;
    translate: none;
  }

  :global(.js) .work__look:not(.is-visible) .work__look-ch {
    opacity: 0;
  }

  .work__look:global(.is-visible) .work__look-ch {
    animation: look-slam 460ms var(--motion-ease-snap) both;
  }

  .work__look:global(.is-visible) .work__look-ch:nth-child(2) {
    animation-delay: 130ms;
  }

  .work__look:global(.is-visible) .work__look-bang {
    animation:
      look-slam 460ms var(--motion-ease-snap) 280ms both,
      look-hop 2.6s ease-in-out 1.4s infinite;
  }

  .work__look:global(.is-visible) .work__look-word {
    animation: look-jolt 2.6s linear 1.4s infinite;
  }

  @keyframes look-slam {
    from {
      opacity: 0;
      scale: 2.4;
      rotate: -14deg;
    }

    60% {
      opacity: 1;
      scale: 0.9;
    }

    to {
      scale: 1;
      rotate: 0deg;
    }
  }

  @keyframes look-hop {
    0%,
    60%,
    100% {
      translate: 0 0;
      rotate: 0deg;
    }

    68% {
      translate: 0 -0.25em;
      rotate: 14deg;
    }

    76% {
      translate: 0 0;
      rotate: -10deg;
    }

    84% {
      rotate: 5deg;
    }
  }

  @keyframes look-jolt {
    0%,
    62%,
    80%,
    100% {
      translate: 0 0;
    }

    66% {
      translate: -4px 0;
    }

    70% {
      translate: 4px 0;
    }

    74% {
      translate: -2px 0;
    }
  }

  .work__look-note {
    font-family: var(--font-mono);
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }

  .work__more {
    position: relative;
    margin-top: var(--spacing-16);
  }

  /* Stacking, back to front: the coming soon card, the arrow, the project
     cards. */
  .work__stage {
    position: relative;
    isolation: isolate;
  }

  .work__cards > li {
    position: relative;
    z-index: 2;
  }

  /* A small tilted tag on each card with one fact about the project, which
     wobbles now and then like it was stuck on in a hurry. */
  .work__tag {
    position: absolute;
    top: -14px;
    right: 12px;
    z-index: 1;
    padding: 6px 10px;
    border: var(--border-regular) solid var(--color-ink-1000);
    background: var(--color-yellow-500);
    color: var(--color-ink-1000);
    font: 700 0.8125rem / 1 var(--font-mono);
    text-transform: uppercase;
    transform-origin: 50% 0;
    animation: tag-wobble 3.2s ease-in-out infinite;
  }

  .work__cards > li:nth-child(2) .work__tag {
    background: var(--color-bg-secondary);
    animation-delay: -1.6s;
  }

  @keyframes tag-wobble {
    0%,
    78%,
    100% {
      transform: rotate(6deg);
    }

    84% {
      transform: rotate(-2deg);
    }

    90% {
      transform: rotate(10deg);
    }

    95% {
      transform: rotate(4deg);
    }
  }

  /* The next case study: a black card tilted behind the arrow head, its
     Japanese "in preparation" above the head and the title below it. */
  .work__cards > .work__soon {
    z-index: 0;
    align-self: stretch;
    justify-self: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 82%;
    margin-block: var(--spacing-6);
    padding: var(--spacing-4);
    background: var(--color-ink-1000);
    color: var(--color-paper-100);
    transform: rotate(7deg);
  }

  .work__soon-jp {
    padding: var(--spacing-3);
    border: 2px dashed var(--color-yellow-500);
    color: var(--color-yellow-500);
    font: 900 clamp(1.5rem, 3vw, 2.5rem) / 1 var(--font-jp);
    text-align: center;
  }

  .work__soon-title {
    margin-top: auto;
    font: 400 clamp(1.25rem, 2.4vw, 2rem) / 1 var(--font-display);
    text-transform: uppercase;
  }

  .work__soon-meta {
    margin-top: var(--spacing-2);
    color: var(--color-yellow-500);
    font: 500 0.75rem / 1.2 var(--font-mono);
    text-transform: uppercase;
  }

  /* How I work: six heavy boxes joined by pink arrows, centred under the
     cards. The last one, Iterate, is pink and its loop sign turns slowly,
     since the process goes round again. */
  .work__process {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-2);
    margin: var(--spacing-16) 0 0;
    padding: 0;
    list-style: none;
  }

  .work__process li {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .work__process li:not(:last-child)::after {
    content: "→";
    color: var(--color-bg-primary);
    font: 400 1.75rem / 1 var(--font-display);
  }

  .work__step {
    display: grid;
    gap: 4px;
    min-width: 104px;
    padding: var(--spacing-3) var(--spacing-4);
    border: 2.5px solid var(--color-ink-1000);
    background: var(--color-bg-surface);
  }

  .work__step-num {
    color: var(--color-text-accent);
    font: 500 0.75rem / 1 var(--font-mono);
  }

  .work__step-name {
    font: 400 1.5rem / 1 var(--font-display);
    text-transform: uppercase;
  }

  .work__process li:last-child .work__step {
    background: var(--color-bg-primary);
    color: var(--color-text-on-primary);
  }

  .work__process li:last-child .work__step-num {
    display: flex;
    justify-content: space-between;
    color: inherit;
  }

  .work__step-loop {
    display: inline-block;
    font-size: 1rem;
    animation: step-loop 4s linear infinite;
  }

  @keyframes step-loop {
    to {
      rotate: 360deg;
    }
  }

  /* The tail starts well past the left edge of the page, so the nudge never
     shows its end. */
  .work__arrow {
    --arrow-h: clamp(220px, 22vw, 300px);
    position: absolute;
    top: calc(50% - var(--arrow-h) / 2);
    left: calc(-1 * var(--gutter) - 64px);
    right: 6%;
    z-index: 1;
    height: var(--arrow-h);
    pointer-events: none;
  }

  /* Shoots in from off the left edge instead of the usual rise. */
  :global(.js) .work__arrow[data-reveal]:not(.is-visible) {
    opacity: 1;
    translate: -105% 0;
  }

  .work__arrow-move {
    display: flex;
    height: 100%;
    animation: arrow-nudge 1.2s ease-in-out infinite;
  }

  @keyframes arrow-nudge {
    50% {
      transform: translateX(12px);
    }
  }

  @keyframes arrow-nudge-down {
    50% {
      transform: translateY(12px);
    }
  }

  .work__arrow-shaft {
    flex: 1;
    align-self: center;
    height: 56%;
    background: var(--color-bg-primary);
    border-block: 4px solid var(--color-ink-1000);
  }

  .work__arrow-head {
    flex: none;
    width: calc(var(--arrow-h) * 0.72);
    height: var(--arrow-h);
    margin-left: -2px;
    overflow: visible;
  }

  .work__arrow-head polygon {
    fill: var(--color-bg-primary);
  }

  .work__arrow-head path {
    fill: none;
    stroke: var(--color-ink-1000);
    stroke-width: 4px;
    stroke-linejoin: miter;
    vector-effect: non-scaling-stroke;
  }

  .work__cards {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--spacing-16);
    margin: var(--spacing-16) 0 0;
    padding: 0 var(--spacing-6);
    list-style: none;
  }

  /* Skills & tools */
  .skills {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 1fr);
    align-items: center;
    gap: var(--spacing-12);
    padding-block: 72px;
    background: var(--color-bg-page);
    color: var(--color-text-primary);
    overflow: clip;
  }

  :global(.skills__stripes) {
    left: var(--gutter);
    top: 24px;
    width: 96px;
  }

  :global(.skills__patch) {
    right: -90px;
    top: -166px;
    width: 400px;
  }

  .skills__copy {
    position: relative;
    display: grid;
    gap: var(--spacing-6);
  }

  .skills__title {
    font: 400 clamp(3rem, 6.7vw, 6rem) / 1 var(--font-display);
    text-transform: uppercase;
  }

  .skills__tools {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-6);
    margin: 0;
    padding: 0;
  }

  /* As in Figma: one large tilted eye strip in front of a long, flat pink
     shard and a halftone burst. */
  .skills__art {
    position: relative;
    min-height: 320px;
  }

  .skills__art > :global(*) {
    position: absolute;
  }

  :global(.skills__burst) {
    left: 16%;
    top: 17%;
    width: 52%;
  }

  :global(.skills__shard) {
    left: 7%;
    top: 22%;
    width: 88%;
    height: auto;
    aspect-ratio: 580 / 171;
    rotate: 6deg;
  }

  /* The eye strip: the character drawing cropped to her eyes, in a black
     frame. */
  .skills__strip {
    left: 1%;
    top: 12%;
    width: 106%;
    aspect-ratio: 560 / 160;
    rotate: -4deg;
    background: var(--color-ink-900);
  }

  .skills__strip > * {
    position: absolute;
    max-width: none;
  }

  .skills__strip img {
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* About */
  .about {
    display: grid;
    grid-template-columns: 480px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--spacing-16);
    padding-block: var(--spacing-24);
    overflow: clip;
  }

  .about__portrait {
    position: relative;
    height: 580px;
  }

  /* The portrait is a loose pile of three playing cards, each its own
     shape and size, tossed down at its own angle: a black outlined manga
     burst at the back, the slanted pink shard, and the photo on top. Once the
     pile is well on screen they slam onto the page one after another, back
     card first, manga-panel style. Then they drift a little out of step,
     and on hover they loosen apart.
     Layers: the card moves for the slam, its face for the hover, and its
     front for the drift. */
  .about__card {
    position: absolute;
    --float: -6px;
  }

  .about__card--burst {
    left: 110px;
    top: -30px;
    width: 390px;
    height: 390px;
    --tilt: 8deg;
    --deal-delay: 0ms;
    --dur: 5.5s;
    --delay: -4s;
  }

  .about__card--shard {
    left: -36px;
    top: 150px;
    width: 470px;
    aspect-ratio: 400 / 320;
    --tilt: -3deg;
    --deal-delay: 200ms;
    --dur: 6.5s;
    --delay: -2s;
  }

  .about__card--photo {
    left: 44px;
    top: 56px;
    width: 350px;
    height: 450px;
    --tilt: -5deg;
    --deal-delay: 400ms;
    --dur: 6s;
  }

  .about__face {
    height: 100%;
    transition: transform 550ms var(--motion-ease-snap);
  }

  .about__front {
    position: absolute;
    inset: 0;
  }

  .about__card--burst svg {
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--color-ink-900);
    stroke-width: 6;
    stroke-linejoin: miter;
  }

  .about__front :global(.decor) {
    width: 100%;
    height: 100%;
  }

  .about__portrait.is-focus .about__card--photo .about__face {
    transform: translate(-4px, -8px) rotate(-2deg);
  }

  .about__portrait.is-focus .about__card--shard .about__face {
    transform: translate(-18px, 12px) rotate(-4deg);
  }

  .about__portrait.is-focus .about__card--burst .about__face {
    transform: translate(20px, -10px) rotate(5deg);
  }

  .about__panel {
    overflow: hidden;
    border: 6px solid var(--color-yellow-500);
    background: var(--color-bg-accent-subtle);
  }

  /* Taller than the panel by twice the parallax, so the drift never shows
     an edge. The parallax is small so her head sits low enough in the frame. */
  .about__panel img {
    position: absolute;
    left: 0;
    top: -16px;
    width: 100%;
    height: calc(100% + 32px);
    max-width: none;
    object-fit: cover;
    object-position: 50% 0;
  }

  .about__copy {
    position: relative;
    display: grid;
    gap: var(--spacing-6);
  }

  .about__title {
    font: 400 clamp(3.5rem, 7.8vw, 7rem) / 1 var(--font-display);
    text-transform: uppercase;
  }

  .stats {
    display: flex;
    margin: 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    padding-inline: 24px;
    border-left: var(--border-thin) solid var(--color-border-subtle);
  }

  .stats div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .stats dt {
    color: var(--color-text-secondary);
  }

  .stats dd {
    margin: 0;
    font: 400 3.5rem / 1 var(--font-display);
  }

  /* Anton has no ∞, so it is drawn: a heavy loop as tall as the digits. */
  .stats__infinity svg {
    height: 1em;
    width: auto;
    fill: none;
    stroke: currentColor;
