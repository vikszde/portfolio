---
// Landing page, built from the Figma "Landing / Desktop" and "Landing / Mobile"
// frames: hero, selected work, skills & tools, about, contact.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Button from "../components/Button.astro";
import Sparkle from "../components/Sparkle.astro";
import Decor from "../components/Decor.astro";
import ProjectCard from "../components/ProjectCard.astro";
import ToolChip from "../components/ToolChip.astro";
import Logo from "../components/Logo.astro";
import Intro from "../components/Intro.astro";
import { site, projects } from "../data/site";
import charTrace from "../assets/art/char-trace.webp?url";
import portrait from "../assets/photo/viki-portrait.webp?url";
import eyeStrip from "../assets/art/eye-strip.webp?url";
import nearbioCover from "../assets/work/nearbio-cover.webp?url";
import barterlandCover from "../assets/work/barterland-cover.webp?url";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const covers: Record<string, string | undefined> = { nearbio: nearbioCover, barterland: barterlandCover };
const shapes = ["A", "B", "C"] as const;
const tilts = [-1.5, 1, -0.8];
// About me: the manga burst card, as points on a 100 × 100 box.
const burst = [[50, 2], [55.7, 17.5], [65, 8.7], [66.5, 21.4], [80.2, 14], [75.3, 28.8], [86.4, 29], [81, 38.7], [97.3, 41.7], [83, 50], [94.3, 57.8], [81, 61.3], [87.2, 71.5], [75.3, 71.2], [80.9, 86.8], [66.5, 78.6], [65, 91.3], [55.7, 82.5], [50, 97], [44.3, 82.5], [35.6, 89.5], [33.5, 78.6], [20.4, 85.2], [24.7, 71.2], [8.4, 74], [19, 61.3], [7.7, 57.5], [17, 50], [3.7, 41.8], [19, 38.7], [11.9, 28], [24.7, 28.8], [19.1, 13.2], [33.5, 21.4], [35.6, 10.5], [44.3, 17.5]];
const burstPoints = burst.map(([x, y]) => `${x},${y}`).join(" ");
---

<Base title="Viktória Varga · Product designer & visual creator">
  <Intro />
  <Nav current="Home" />

  <main>
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy" data-stagger="110">
        <p class="text-label-m accent" data-reveal>Design • Create • Experiment <span aria-hidden="true">✦</span></p>
        <h1 id="hero-title" class="hero__title">
          <span class="hero__line"><span>Product</span></span>
          <span class="hero__line"><span>designer <span class="pink">&amp;</span></span></span>
          <span class="hero__line"><span>visual creator</span></span>
        </h1>
        <p class="text-body-l secondary hero__intro" data-reveal>I turn messy problems into clear, thoughtful digital experiences with personality.</p>
        <div class="row" data-reveal>
          <Button href="#work" arrow>View my work</Button>
          <Button variant="ghost" href="#about">About me</Button>
        </div>
        <a class="hero__scroll text-label-m" href="#work" data-reveal>Scroll <span class="hero__scroll-arrow" aria-hidden="true">↓</span></a>
      </div>

      <div class="hero__art">
        <Decor name="orbit" class="hero__orbit anim-sway" />
        <span class="hero__circle" aria-hidden="true"></span>
        <div class="hero__frame">
          <div class="hero__character" role="img" aria-label="Anime-style character illustration in a black and pink outfit">
            <img src={charTrace} alt="" width="832" height="1216" />
          </div>
        </div>
        <div class="hero__bubble" data-reveal="pop" aria-hidden="true">
          <p class="hero__bubble-box"><span data-typing>Hi, I’m Viki.</span><span class="hero__bubble-cursor"></span></p>
        </div>
        <svg class="hero__heart anim-beat" viewBox="-12 -12 124 116" aria-hidden="true" focusable="false">
          <path class="hero__heart-edge" d="M50 90C18 64 2 46 2 26C2 12 13 2 27 2C37 2 45 7 50 15C55 7 63 2 73 2C87 2 98 12 98 26C98 46 82 64 50 90Z" />
          <path class="hero__heart-cut" d="M50 90C18 64 2 46 2 26C2 12 13 2 27 2C37 2 45 7 50 15C55 7 63 2 73 2C87 2 98 12 98 26C98 46 82 64 50 90Z" />
          <path class="hero__heart-face" d="M50 90C18 64 2 46 2 26C2 12 13 2 27 2C37 2 45 7 50 15C55 7 63 2 73 2C87 2 98 12 98 26C98 46 82 64 50 90Z" />
        </svg>
      </div>

      <Decor name="perspective-grid" tone="accent" moving stretch class="hero__grid" />
    </section>

    <!-- Selected work -->
    <section class="work" id="work" aria-labelledby="work-title">
      <header class="section-head" data-stagger="90">
        <p class="text-label-m accent" data-reveal>01 / Work</p>
        <h2 id="work-title" class="text-display-l section-head__title" data-reveal="slam">Selected work <Sparkle color="pink" size={36} class="anim-twinkle" /></h2>
        <p class="text-katakana" lang="ja" data-reveal>つくる、試す、好きで満たす。</p>
        <p class="text-body-m secondary" data-reveal>Selected projects from early ideas and research to polished digital experiences.</p>
        <p class="work__look" lang="ja" aria-hidden="true" data-reveal="look"><span class="work__look-word"><span class="work__look-ch">見</span><span class="work__look-ch">て</span><span class="work__look-ch work__look-bang pink">!</span></span><span class="work__look-note text-label-s">Mite = look</span></p>
      </header>
      <div class="work__stage">
        <div class="work__arrow" aria-hidden="true" data-reveal="arrow">
          <div class="work__arrow-move">
            <span class="work__arrow-shaft"></span>
            <svg class="work__arrow-head" viewBox="0 0 72 100" preserveAspectRatio="none">
              <polygon points="0,0 72,50 0,100" />
              <path d="M1 22V1L71 50L1 99V78" />
            </svg>
          </div>
        </div>
        <ul class="work__cards" data-stagger="150">
          {
            projects.slice(0, 2).map((project, i) => (
              <li data-reveal="card" data-focus>
                <ProjectCard
                  number={project.number}
                  title={project.title}
                  summary={project.summary}
                  tags={[...project.tags]}
                  href={`${base}work/${project.slug}/`}
                  cover={covers[project.slug]}
                  shape={shapes[i]}
                  tilt={tilts[i]}
                />
                <span class="work__tag">{project.highlight}</span>
              </li>
            ))
          }
          <!-- The next case study, teased behind the arrow head. -->
          <li class="work__soon" data-reveal="card">
            <span class="work__soon-jp" lang="ja">準備中</span>
            <span class="work__soon-title">Coming soon</span>
            <span class="work__soon-meta">Next case study</span>
          </li>
        </ul>
      </div>
      <ol class="work__process" aria-label="How I work" data-stagger="110">
        <li data-reveal="pop"><span class="work__step"><span class="work__step-num">01</span><span class="work__step-name">Research</span></span></li>
        <li data-reveal="pop"><span class="work__step"><span class="work__step-num">02</span><span class="work__step-name">Define</span></span></li>
        <li data-reveal="pop"><span class="work__step"><span class="work__step-num">03</span><span class="work__step-name">Explore</span></span></li>
        <li data-reveal="pop"><span class="work__step"><span class="work__step-num">04</span><span class="work__step-name">Design</span></span></li>
        <li data-reveal="pop"><span class="work__step"><span class="work__step-num">05</span><span class="work__step-name">Test</span></span></li>
        <li data-reveal="pop"><span class="work__step"><span class="work__step-num">06 <span class="work__step-loop" aria-hidden="true">↻</span></span><span class="work__step-name">Iterate</span></span></li>
      </ol>
      <div class="work__more" data-reveal>
        <Button variant="ghost" href={`${base}work/`} arrow>All projects</Button>
      </div>
    </section>

    <!-- Skills & tools (always dark) -->
    <section class="skills theme-dark" aria-labelledby="skills-title">
      <Decor name="stripes" class="skills__stripes anim-slide" />
      <Decor name="halftone-patch" tone="accent" class="skills__patch anim-breathe" />
      <div class="skills__copy" data-stagger="90">
        <p class="text-label-m accent" data-reveal>02 / Skills</p>
        <h2 id="skills-title" class="skills__title" data-reveal="slam">Skills &amp; tools</h2>
        <p class="text-katakana" lang="ja" data-reveal>スキルとツール</p>
        <p class="text-body-l secondary" data-reveal>A mix of product thinking, visual design and illustration to create cohesive digital experiences.</p>
        <ul class="skills__tools" aria-label="Tools I use" data-reveal data-stagger="80">
          <ToolChip tool="figma" data-reveal="pop" />
          <ToolChip tool="illustrator" data-reveal="pop" />
          <ToolChip tool="photoshop" data-reveal="pop" />
          <ToolChip tool="claude" data-reveal="pop" />
          <ToolChip tool="rive" data-reveal="pop" />
        </ul>
        <div data-reveal><Button variant="ghost" href={`${base}about/`} arrow>See more</Button></div>
      </div>
      <div class="skills__art" aria-hidden="true">
        <Decor name="halftone-patch" tone="accent" class="skills__burst anim-breathe" />
        <Decor name="slab" stretch class="skills__shard anim-sway" />
        <div class="skills__strip parallax-x">
          <img src={eyeStrip} alt="" width="560" height="160" loading="lazy" />
