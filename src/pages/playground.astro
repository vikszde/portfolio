---
// Placeholder until the Playground page is designed.
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Button from "../components/Button.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<Base title="Playground · Viktória Varga">
  <Nav current="Playground" />
  <main class="soon">
    <p class="text-label-m accent">Playground</p>
    <h1 class="text-display-l">Coming soon</h1>
    <p class="text-body-l">Sketches, experiments and illustrations will live here.</p>
    <Button variant="ghost" href={base}>← Home</Button>
  </main>
</Base>

<style>
  .soon {
    display: grid;
    justify-items: start;
    gap: var(--spacing-6);
    padding: var(--spacing-24) clamp(var(--spacing-4), 5.5vw, 80px);
  }

  .accent {
    color: var(--color-text-accent);
  }
</style>
