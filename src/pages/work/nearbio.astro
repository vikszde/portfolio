---
// nearb.io case study, built from the Figma "nearb.io / Desktop" and
// "nearb.io / Mobile" frames on the Case study page. Screenshots are crops of
// the nearb.io product file and of the implemented app, cut to the same
// frames as the Figma image panels.
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Button from "../../components/Button.astro";
import Tag from "../../components/Tag.astro";
import Sticker from "../../components/Sticker.astro";
import Sparkle from "../../components/Sparkle.astro";
import Decor from "../../components/Decor.astro";
import ToolChip from "../../components/ToolChip.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Logo from "../../components/Logo.astro";
import SectionHead from "../../components/case-study/SectionHead.astro";
import Shot from "../../components/case-study/Shot.astro";
import CaseIcon from "../../components/case-study/CaseIcon.astro";
import Device from "../../components/case-study/Device.astro";
import { projects } from "../../data/site";
import eyeStrip from "../../assets/art/eye-strip.webp?url";
import barterlandCover from "../../assets/work/barterland-cover.webp?url";

import heroLanding from "../../assets/work/nearbio/hero-landing.webp";
import flowReturnVisit from "../../assets/work/nearbio/flow-return-visit.webp";
import wireframeAddress from "../../assets/work/nearbio/wireframe-address.webp";
import wireframeSaved from "../../assets/work/nearbio/wireframe-saved.webp";
import wireframeCompare from "../../assets/work/nearbio/wireframe-compare.webp";
import landingEarlier from "../../assets/work/nearbio/page-landing-earlier.webp";
import landingCurrent from "../../assets/work/nearbio/page-landing-current.webp";
import addressEarlier from "../../assets/work/nearbio/page-address-earlier.webp";
import addressCurrent from "../../assets/work/nearbio/page-address-current.webp";
import explore from "../../assets/work/nearbio/explore.webp";
import saved from "../../assets/work/nearbio/saved.webp";
import savedCard from "../../assets/work/nearbio/saved-card.webp";
import compareOverview from "../../assets/work/nearbio/compare-overview.webp";
import compareOverviewMobile from "../../assets/work/nearbio/compare-overview-mobile.webp";
import compareTransport from "../../assets/work/nearbio/compare-transport.webp";
import compareTransportMobile from "../../assets/work/nearbio/compare-transport-mobile.webp";
import savedMobile from "../../assets/work/nearbio/page-saved-mobile.webp";
import compareMobile from "../../assets/work/nearbio/page-compare-mobile.webp";
import scoreGaugeFigma from "../../assets/work/nearbio/scoregauge-figma.webp";
import scoreGaugeStorybook from "../../assets/work/nearbio/scoregauge-storybook.webp";
import implementedLanding from "../../assets/work/nearbio/page-implemented-landing.webp";
import implementedSaved from "../../assets/work/nearbio/page-implemented-saved.webp";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const next = projects.find((project) => project.slug === "barterland")!;

const full = "(min-width: 1440px) 1280px, 92vw";
const narrow = "(min-width: 1100px) 1000px, 92vw";
const half = "(min-width: 1440px) 620px, (min-width: 768px) 45vw, 92vw";
const third = "(min-width: 1440px) 405px, (min-width: 768px) 30vw, 92vw";

const details = [
  ["Role", "Product design, visual identity, and AI-assisted frontend implementation."],
  ["Collaboration", "Working with a developer on the product."],
  ["Current scope", "Product designs in Figma, a coded component library, and selected implemented interfaces."],
];

const contributions = [
  { icon: "pen-tool", title: "Product design", body: "User flows, wireframes, desktop and mobile layouts, and detailed interface designs." },
  { icon: "stack", title: "Identity and system", body: "The logo, visual foundations, reusable components, and their variants and states." },
  { icon: "code", title: "AI-assisted implementation", body: "The Storybook component library, landing page, and saved-locations interface, built with Claude." },
] as const;

const personas = [
  { icon: "briefcase", title: "Real-estate agent", body: "May need to review several addresses and communicate their differences.", tilt: -1 },
  { icon: "home", title: "Home buyer", body: "May evaluate a location for long-term suitability.", tilt: 1 },
  { icon: "key", title: "Renter", body: "May prioritise everyday convenience and access to essential services.", tilt: -0.8 },
] as const;

const callouts = [
  { n: 1, title: "Overall score", body: "An entry point for a quick first impression.", x: 0.3, y: 0.7 },
  { n: 2, title: "Category cards", body: "Break the location down into specific factors, each with its data sources.", x: 0.3, y: 15.1 },
  { n: 3, title: "Map", body: "Adds geographic context.", x: 0.3, y: 46.7 },
  { n: 4, title: "AI summary", body: "A written overview alongside the structured information.", x: 67.5, y: 46.7 },
];

const groups = [
  { title: "Visual foundations", body: "Colour, typography, spacing, and radius establish a shared visual language across the product." },
  { title: "Reusable interface patterns", body: "Navigation, account controls, buttons, inputs, cards, dialogs, and feedback components support recurring interactions." },
  { title: "Location-specific components", body: "Score gauges, category scores, metric bars, rating tags, and location cards provide reusable ways to present location information." },
];

const nextSteps = [
  { icon: "users", title: "Understand audience priorities", body: "Speak with potential users about how they currently evaluate locations, which information they trust, and where they encounter difficulties." },
  { icon: "checklist", title: "Test the saved-locations journey", body: "Ask participants to save an address, find it again, and reopen its details. Observe where they hesitate or lose context." },
  { icon: "chart", title: "Evaluate comparison and score comprehension", body: "Ask participants to compare two addresses for a stated need and explain their choice. Explore how they interpret the overall scores, category scores, and displayed differences." },
  { icon: "refresh", title: "Iterate from the findings", body: "Use the findings to prioritise changes to the information hierarchy, workflows, and supporting components." },
] as const;
---

<Base
  title="nearb.io case study · Viktória Simóné Varga"
  description="How Viktória Simóné Varga designed nearb.io, from user flows and wireframes to a design system, Storybook library, and implemented interfaces."
  type="article"
  image="og-nearbio.png"
  imageAlt="The nearb.io case study: “From an address to a more informed decision”, with the nearb.io landing page on a monitor and the Saved page on a phone."
>
  <Nav current="Work" />

  <main class="case">
    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__copy" data-stagger="90">
        <div class="hero__eyebrow" data-reveal>
          <Tag>Case study 01</Tag>
          <a class="text-label-m hero__back" href={`${base}work/`}>← All work</a>
        </div>
        <h1 id="hero-title" class="hero__title" data-reveal="slam">nearb.io</h1>
        <p class="hero__subtitle" data-reveal>From an address to a more informed decision.</p>
        <p class="text-body-l secondary" data-reveal>nearb.io brings location information together to help people explore addresses, save options, and compare places.</p>
        <p class="text-body-l secondary" data-reveal>I designed the product experience, visual identity, and design system—from user flows and wireframes to detailed screens. Using Claude, I also built the Storybook component library and implemented the landing page and saved-locations interface.</p>
      </div>

      <div class="hero__art" aria-hidden="true">
        <div class="hero__strip anim-sway"><img src={eyeStrip} alt="" width="560" height="160" /></div>
        <p class="text-label-s hero__note">More context.<br />Better decisions.<br />Brighter places.</p>
        <Device class="hero__landing anim-float" device="monitor" reveal={false} src={heroLanding} alt="" sizes="(min-width: 1440px) 600px, (min-width: 768px) 44vw, 84vw" />
        <Device class="hero__phone anim-float" device="phone" reveal={false} src={savedMobile} alt="" sizes="(min-width: 768px) 220px, 34vw" />
        <Sparkle color="ink" size={52} class="hero__spark hero__spark--1 anim-twinkle" />
        <Sparkle color="pink" size={36} class="hero__spark hero__spark--2 anim-twinkle" />
        <Sparkle color="aqua" size={28} class="hero__spark hero__spark--3 anim-twinkle" />
      </div>

      <div class="hero__meta" data-stagger="90">
        <dl class="hero__details" data-reveal>
          {
            details.map(([term, value]) => (
              <div>
                <dt class="text-label-m accent">{term}</dt>
                <dd class="text-body-m secondary">{value}</dd>
              </div>
            ))
          }
        </dl>
        <div class="hero__tools" data-reveal>
          <p class="text-label-m accent">Tools</p>
          <ul aria-label="Tools">
            <ToolChip tool="figma" />
            <ToolChip tool="claude" />
            <ToolChip tool="storybook" />
          </ul>
        </div>
      </div>
    </section>

    <div class="ticker theme-dark" aria-hidden="true"><div class="ticker__track"><span>Explore</span><i>✦</i><span>Save</span><i>✦</i><span>Compare</span><i>✦</i><span>Explore</span><i>✦</i><span>Save</span><i>✦</i><span>Compare</span><i>✦</i><span>Explore</span><i>✦</i><span>Save</span><i>✦</i><span>Compare</span><i>✦</i><span>Explore</span><i>✦</i><span>Save</span><i>✦</i><span>Compare</span><i>✦</i><span>Explore</span><i>✦</i><span>Save</span><i>✦</i><span>Compare</span><i>✦</i><span>Explore</span><i>✦</i><span>Save</span><i>✦</i><span>Compare</span><i>✦</i><span>Explore</span><i>✦</i><span>Save</span><i>✦</i><span>Compare</span><i>✦</i><span>Explore</span><i>✦</i><span>Save</span><i>✦</i><span>Compare</span><i>✦</i></div></div>

    <!-- 01 The problem -->
    <section class="problem split" aria-labelledby="problem-title">
      <div class="split__head">
        <SectionHead number="01" label="The problem" id="problem-title">An address is only the starting point.</SectionHead>
        <Decor name="city" width={270} class="problem__city parallax" />
      </div>
      <div class="stack" data-stagger="90">
        <p class="text-body-l secondary" data-reveal>Choosing a location involves more than finding it on a map. People may need to consider transport, nearby services, schools, green spaces, and internet availability—and weigh those factors against other options.</p>
        <p class="text-body-l secondary" data-reveal>nearb.io brings these categories into one experience. The design challenge was to make detailed location information approachable while supporting a connected journey: exploring an address, saving it for later, and comparing alternatives.</p>
        <p class="text-body-l secondary" data-reveal>An overall score can provide a starting point, but people also need to understand the individual factors behind it.</p>
      </div>
    </section>

    <!-- 02 My role -->
    <section class="band band--pink" aria-labelledby="role-title">
      <div class="split">
        <SectionHead number="02" label="My role" id="role-title">From product structure to reusable UI.</SectionHead>
        <div class="stack" data-stagger="90">
          <p class="text-body-l secondary" data-reveal>My work covered user flows, wireframes, interface design, the logo, and the design system. I also created assumption-based proto-personas to explore potential audiences and their different priorities.</p>
          <p class="text-body-l secondary" data-reveal>I worked alongside the developer, with responsibility for the product’s design. Using Claude, I translated the Figma system into a Storybook library and implemented the landing page and saved-locations interface.</p>
        </div>
      </div>
      <ul class="ruled ruled--3" data-stagger="90">
        {
          contributions.map((item) => (
            <li data-reveal>
              <CaseIcon name={item.icon} />
              <h3 class="text-label-strong">{item.title}</h3>
              <p class="text-body-m secondary">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 03 People & priorities -->
    <section class="band" aria-labelledby="people-title">
      <Sparkle color="aqua" size={48} class="band__spark band__spark--ink anim-twinkle" />
      <div class="split">
        <SectionHead number="03" label="People & priorities" id="people-title">One product, different priorities.</SectionHead>
        <div class="stack" data-stagger="90">
          <p class="text-body-l secondary" data-reveal>A home buyer, renter, and real-estate agent may evaluate the same address for different reasons.</p>
          <p class="text-body-l secondary" data-reveal>I created assumption-based proto-personas to explore these possible needs. They helped frame design questions, but they were not validated through user interviews.</p>
        </div>
      </div>
      <div class="personas">
        <Tag color="neutral">Assumption-based proto-personas</Tag>
        <ul class="personas__list" data-stagger="110">
          {
            personas.map((persona) => (
              <li class="persona" style={`--tilt: ${persona.tilt}deg`} data-reveal="pop">
                <CaseIcon name={persona.icon} size={36} />
                <h3 class="text-h3">{persona.title}</h3>
                <p class="text-body-m secondary">{persona.body}</p>
              </li>
            ))
          }
        </ul>
        <Sticker color="white" class="personas__note">Needs<br />validation</Sticker>
      </div>
      <div class="question" data-reveal>
        <p class="text-label-m accent">The design question</p>
        <p class="question__text">How can one experience support different priorities without becoming overly complex?</p>
        <p class="text-body-l secondary">The interface combines an overall view with category-level information. This gives people a common starting point while leaving room to examine the aspects relevant to their own situation.</p>
        <p class="text-body-l secondary">Which audience to prioritise—and where their needs require different workflows—remains a question for research.</p>
      </div>
    </section>

    <!-- 04 Flows, wireframes & iterations -->
    <section class="band band--pink" id="flows" aria-labelledby="flows-title">
      <div class="split">
        <SectionHead number="04" label="Flows, wireframes & iterations" id="flows-title">Shaping the experience before refining the interface.</SectionHead>
        <p class="text-body-l secondary" data-reveal>I created user flows and wireframes alongside the detailed screen designs. These explored the product’s structure, the connections between screens, and how information would be organised.</p>
      </div>

      <div class="block">
        <div class="split split--tight" data-reveal>
          <div class="block__title">
            <p class="text-label-m accent">User flows</p>
            <h3 class="text-h3">Connecting individual screens into a product journey.</h3>
          </div>
          <p class="text-body-l secondary">The flows map how people move through the experience, including exploring an address, saving locations, and comparing alternatives.</p>
        </div>
        <Shot src={flowReturnVisit} alt="User flow for a return visit: a signed-in user opens Saved, searches or filters their saved places, and opens Details on a card to reach the address report. With no saved places, an empty state links to the first-check flow." caption="One of four flows: a return visit from the Saved page back into an address report." sizes={full} />
      </div>

      <div class="block">
        <div class="split split--tight" data-reveal>
          <div class="block__title">
            <p class="text-label-m accent">Wireframes</p>
            <h3 class="text-h3">Planning the structure of each screen.</h3>
          </div>
          <p class="text-body-l secondary">The wireframes show the underlying layout and information hierarchy before the interface’s visual detail.</p>
        </div>
        <div class="grid grid--3">
          <Shot src={wireframeAddress} alt="Wireframe of the address details page: overall score, category cards, map, AI summary, commute times, and a venue table." caption="Address details" sizes={third} />
          <Shot src={wireframeSaved} alt="Wireframe of the Saved page: summary stats, a grid of saved-location cards, and saved comparisons." caption="Saved locations" sizes={third} />
          <Shot src={wireframeCompare} alt="Wireframe of the Compare page: two addresses side by side with a category table, AI summary, and map comparison." caption="Compare" sizes={third} />
        </div>
      </div>

      <div class="block">
        <div class="split split--tight" data-reveal>
          <div class="block__title">
            <p class="text-label-m accent">Landing page evolution</p>
            <h3 class="text-h3">Introducing the product and its starting point.</h3>
          </div>
          <p class="text-body-l secondary">The earlier and current landing-page designs show how the presentation developed. The current version introduces address evaluation, places address entry prominently, and explains the experience through supporting product content.</p>
        </div>
        <div class="grid grid--devices">
          <Device device="monitor" reveal="from-left" src={landingEarlier} alt="Earlier landing page: headline, a separate address field and Check location button, and a How To Get Started section with three steps." caption="An earlier version of the landing page." />
          <Device device="monitor" reveal="from-right" src={landingCurrent} alt="Current landing page: headline, a subtitle naming the categories, a search field with the Check location button inside it, example addresses, and How it works." caption="The current landing-page design, with address entry as its main action." />
        </div>
        <div class="why" data-reveal>
          <p class="text-label-m accent">What changed &amp; why</p>
          <p class="text-body-m">I moved the primary action into the search field to make address entry more direct, and added example addresses to provide a clear starting point. The subtitle now introduces the evaluation categories, helping users understand what nearb.io offers before exploring a location.</p>
        </div>
      </div>

      <div class="block">
        <div class="split split--tight" data-reveal>
          <div class="block__title">
            <p class="text-label-m accent">Address-detail evolution</p>
            <h3 class="text-h3">Organising a dense set of location information.</h3>
          </div>
          <p class="text-body-l secondary">The current address-detail page starts with an overall score and category summaries, followed by the map and AI summary. This creates a path from a quick overview into more detailed exploration.</p>
        </div>
        <div class="grid grid--devices">
          <Device device="monitor" reveal="from-left" src={addressEarlier} alt="Earlier address page: an overall score, cards listing which delivery, grocery, internet and electricity providers are available, and a venue table below." caption="An earlier approach to presenting address information." />
          <Device device="monitor" reveal="from-right" src={addressCurrent} alt="Current address page: an overall score, category cards with their own scores and summaries, a map of the area, and an AI summary." caption="An overview-led layout combining scores, category information, and geographic context." />
        </div>
        <div class="why" data-reveal>
          <p class="text-label-m accent">What changed &amp; why</p>
          <p class="text-body-m">I shifted the focus from provider availability to information that helps users evaluate a location. Category scores and summaries now provide a clearer overview, while the map, AI summary, and commute information appear before the detailed venue table. This hierarchy prioritises understanding the location before exploring individual data points.</p>
        </div>
      </div>
    </section>

    <!-- 05 The product experience -->
    <section class="band" aria-labelledby="product-title">
      <Sparkle color="aqua" size={64} class="band__spark anim-twinkle" />
      <div class="product__intro">
        <SectionHead number="05" label="The product experience" id="product-title">Explore, save, and compare.</SectionHead>
        <p class="text-body-l secondary">The core experience connects three tasks: understanding a location, keeping it for later, and weighing it against other options.</p>
      </div>

      <article class="feature" aria-labelledby="feature-explore">
        <div class="split split--tight" data-reveal>
          <div class="stack stack--tight">
            <p class="feature__number" data-reveal="slam"><span>01</span><CaseIcon name="search" size={28} /></p>
            <h3 id="feature-explore" class="feature__title">Explore an address</h3>
            <p class="text-h3 feature__sub">Start with an overview, then explore the details.</p>
            <p class="text-body-l secondary">The overall score provides an entry point, while category cards break the location down into more specific factors. The map adds geographic context, and the AI summary provides a written overview alongside the structured information.</p>
          </div>
          <div class="stack">
            <aside class="annotation" aria-label="Design annotation" data-reveal>
              <p class="text-label-m accent annotation__label">Design annotation</p>
              <p class="text-body-l">Balance summary and detail: the overall score is prominent, but the category breakdown remains visible so users can assess individual strengths and weaknesses rather than relying on a single rating.</p>
            </aside>
            <div class="row"><Tag>Designed in Figma</Tag></div>
          </div>
        </div>
        <Shot class="explore-shot narrow" src={explore} alt="Address details for Sándor út 102. A: overall score 9.2, category cards for transport, internet, green areas, and food and delivery, a map of the area, and an AI summary. Numbered markers point to the overall score, category cards, map, and AI summary." sizes={narrow}>
          {
            callouts.map((c) => (
              <span class="callout" style={`left: ${c.x}%; top: ${c.y}%; --i: ${c.n - 1}`} aria-hidden="true">
                {c.n}
              </span>
            ))
          }
        </Shot>
        <ol class="legend narrow" data-stagger="120">
          {
            callouts.map((c) => (
              <li data-reveal="pop">
                <span class="text-label-strong"><b class="legend__n">{c.n}</b>&nbsp;&nbsp;{c.title}</span>
                <span class="text-body-m secondary">{c.body}</span>
              </li>
            ))
          }
        </ol>
      </article>

      <article class="feature" aria-labelledby="feature-save">
        <div class="split split--tight" data-reveal>
          <div class="stack stack--tight">
            <p class="feature__number" data-reveal="slam"><span>02</span><CaseIcon name="bookmark" size={28} /></p>
            <h3 id="feature-save" class="feature__title">Save a location</h3>
            <p class="text-h3 feature__sub">Keep useful context when returning to an address.</p>
            <p class="text-body-l secondary">In the Figma design, saved-location cards bring together the address, a map preview, the overall score, and selected category scores, with buttons to compare the location or open its full report.</p>
            <p class="text-body-l secondary">The saved-locations experience connects an initial search with a decision that may take several visits.</p>
          </div>
          <div class="stack">
            <aside class="annotation" aria-label="Design annotation" data-reveal>
              <p class="text-label-m accent annotation__label">Design annotation</p>
              <p class="text-body-l">Prioritise quick review over full detail: cards surface a small set of scores and location information, while the complete report remains available for deeper exploration.</p>
            </aside>
            <div class="row"><Tag>Designed in Figma</Tag><Tag color="aqua">Interface implemented with Claude</Tag></div>
          </div>
        </div>
        <Shot class="narrow" src={saved} mobile={savedCard} alt="Saved locations page: summary stats for saved places, average score, score change, and best overall score, above saved-location cards with a map preview, overall score, three category scores, and Compare and Details buttons." sizes={narrow} />
      </article>

      <article class="feature" aria-labelledby="feature-compare">
        <div class="split split--tight" data-reveal>
          <div class="stack stack--tight">
            <p class="feature__number" data-reveal="slam"><span>03</span><CaseIcon name="compare" size={28} /></p>
            <h3 id="feature-compare" class="feature__title">Compare alternatives</h3>
            <p class="text-h3 feature__sub">Make the differences easier to inspect.</p>
            <p class="text-body-l secondary">The comparison overview places two addresses side by side, showing their overall ratings, the score for each category, and the difference between them.</p>
            <p class="text-body-l secondary">The detailed transport comparison extends this approach, allowing a closer look at one category.</p>
          </div>
          <div class="stack">
            <aside class="annotation" aria-label="Design annotation" data-reveal>
              <p class="text-label-m accent annotation__label">Design annotation</p>
              <p class="text-body-l">Support individual priorities: rather than presenting one address as the definitive winner, the comparison keeps category-level differences visible so users can weigh the factors that matter most to them.</p>
            </aside>
            <div class="row"><Tag>Designed in Figma</Tag></div>
          </div>
        </div>
        <div class="grid grid--compare narrow">
          <Shot src={compareOverview} mobile={compareOverviewMobile} alt="Comparison overview of Sándor út 102. A and Ráday utca 45.: overall scores 9.2 and 8.1, and a table of category scores with the difference for each." caption="Comparison overview" sizes="(min-width: 1100px) 600px, (min-width: 768px) 55vw, 92vw" />
          <Shot src={compareTransport} mobile={compareTransportMobile} alt="Detailed transport comparison: transport scores for both addresses, nearest metro, bus stops, night routes, airport time, and a transport map." caption="Detailed transport comparison" sizes="(min-width: 1100px) 385px, (min-width: 768px) 35vw, 92vw" />
        </div>
      </article>

      <div class="mobile split split--tight">
        <div class="stack stack--tight">
          <p class="text-label-m accent">Desktop and mobile</p>
          <h3 class="text-h3">Adapting the experience for mobile</h3>
          <p class="text-body-l secondary">I also created mobile layouts for saved locations and comparison. These explore how to present the same information within a narrower space while keeping the main tasks accessible.</p>
          <p class="text-body-m secondary">Mobile layouts for saved locations and comparison. The desktop versions are shown above.</p>
        </div>
        <div class="mobile__phones">
          <Device device="phone" reveal="pop" src={savedMobile} alt="Mobile Saved locations layout: summary stats in a two-column grid, saved-location cards, and an insight card." />
          <Device device="phone" reveal="pop" src={compareMobile} alt="Mobile comparison layout: the two addresses stacked with their overall scores, the category table, and a map comparison." />
        </div>
      </div>
    </section>

    <!-- 06 Design system & implementation (always dark) -->
    <section class="band theme-dark system" id="system" aria-labelledby="system-title">
      <Sparkle color="pink" size={40} class="band__spark anim-twinkle" />
      <div class="split">
        <SectionHead number="06" label="Design system & implementation" id="system-title">Connecting Figma and code.</SectionHead>
        <div class="stack" data-stagger="90">
          <p class="text-body-l secondary" data-reveal>I created the nearb.io logo and design system alongside the product interface. The system combines visual foundations, reusable interface patterns, and components specific to location evaluation.</p>
