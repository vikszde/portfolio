  .hero__eyebrow {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: var(--spacing-4);
  }

  .hero__back {
    text-decoration: none;
  }

  .hero__back:hover {
    color: var(--color-text-accent);
  }

  /* Twelve letters: smaller than the other titles, so it stays in its column. */
  .hero__title {
    font: 400 clamp(3.5rem, 8vw, 7.5rem) / 1 var(--font-display);
