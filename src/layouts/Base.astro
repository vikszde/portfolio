---
import "@fontsource/anton/400.css";
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/noto-sans-jp/900.css";
import "../styles/global.css";
import PageTransition from "../components/PageTransition.astro";

interface Props {
  title: string;
  description?: string;
  /** Keep a page out of search results (404, components, tokens). Such
      pages also get no canonical or og:url: they aren't meant to be shared. */
  noindex?: boolean;
  /** Link-preview image: a 1200×630 PNG in public/, captured from the page. */
  image?: string;
  imageAlt?: string;
  /** "article" for case studies, "website" for everything else. */
  type?: "website" | "article";
}

const {
  title,
  description = "Viktória Simóné Varga, product designer.",
  noindex = false,
  image = "og-image.png",
  imageAlt = "Viktória Simóné Varga, product designer & visual creator, next to her anime-style character.",
  type = "website",
} = Astro.props;
// BASE_URL is "/" locally and "/<repo>/" on GitHub Pages project sites.
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// Link previews (LinkedIn, Slack, Messages) need absolute URLs. The deploy
// workflow sets `site`; locally they fall back to the dev server's origin.
const origin = Astro.site ?? Astro.url;
const pageUrl = new URL(Astro.url.pathname, origin).href;
const previewImage = new URL(`${base}${image}`, origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && Astro.site && <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Viktória Simóné Varga" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <title>{title}</title>
    <!-- The site is always Light. Earlier builds saved a theme choice; clear it so nobody gets stuck in Dark. -->
    <script is:inline>
      try {
        localStorage.removeItem("theme");
      } catch {}
      // Scroll reveals start hidden only when JavaScript can show them again.
      document.documentElement.classList.add("js");
      // Arriving through a page transition (PageTransition.astro): cover the
      // page from its first paint so it can open in the same style it closed.
      // A visitor already moving around the site skips the logo intro.
      try {
        const raw = sessionStorage.getItem("pt");
        if (raw) {
          sessionStorage.removeItem("pt");
          const pt = JSON.parse(raw);
          if (Date.now() - pt.t < 10000) {
            const html = document.documentElement;
            html.dataset.pt = pt.k;
            html.dataset.ptX = pt.x;
            html.dataset.ptY = pt.y;
            sessionStorage.setItem("intro-seen", "1");
          }
        }
      } catch {}
    </script>
  </head>
  <body>
    <PageTransition />
    <slot />
    <script>
      import { afterIntro } from "../scripts/after-intro";

      // Scroll reveal: anything marked data-reveal fades and slides in the
      // first time it enters the viewport. Children of a [data-stagger]
      // parent follow each other in order.
      document.querySelectorAll<HTMLElement>("[data-stagger]").forEach((group) => {
        const step = Number(group.dataset.stagger) || 90;
        group.querySelectorAll<HTMLElement>(":scope > [data-reveal]").forEach((item, i) => {
          item.style.setProperty("--reveal-delay", `${i * step}ms`);
        });
      });

      const reveal = (el: Element) => {
        el.classList.add("is-visible");
        el.dispatchEvent(new CustomEvent("reveal"));
      };

      // Whatever is already on screen at load shows straight away, without
      // waiting for the observer's first callback. data-reveal-at="0.6" holds
      // an element back until its top has passed 60% of the viewport height;
      // those are left to the scroll check below rather than the observer.
      const onScreen = (el: HTMLElement) => {
        const box = el.getBoundingClientRect();
        const at = Number(el.dataset.revealAt) || 0.95;
        return box.top < window.innerHeight * at && box.bottom > 0;
      };

      // On the home page a logo intro may be covering the page; the first
      // reveals wait for it to hand off so they play where they can be seen.
      afterIntro(() => {
        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                reveal(entry.target);
                observer.unobserve(entry.target);
              }
            },
            // Reveal as soon as the top crosses the line 10% above the bottom
            // of the screen. A share of the element's own height (the old
            // 0.15) left tall blocks, like a stack of phone shots, as a blank
            // gap for a few hundred pixels of scrolling on phones.
            { rootMargin: "0px 0px -10% 0px", threshold: 0 },
          );
          document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
            if (onScreen(el)) reveal(el);
            else if (!el.dataset.revealAt) observer.observe(el);
          });

          // Jumping to a #section (the nav's Contact, the case studies'
          // closing link) reveals that whole section as one entrance once it
          // arrives. The jump lands the section near the top, and on a short
          // desktop window a tall one (Contact's big title) leaves its lower
          // parts, like the email row, below the reveal line with the scroll
          // already over, so they'd sit blank until the visitor scrolled on.
          let jumpTarget: HTMLElement | null = null;
          const revealJumpTarget = () => {
            if (!jumpTarget) return;
            const box = jumpTarget.getBoundingClientRect();
            if (box.top > window.innerHeight * 0.6 || box.bottom < 0) return;
            jumpTarget.querySelectorAll<HTMLElement>("[data-reveal]:not(.is-visible)").forEach((el) => {
              reveal(el);
              observer.unobserve(el);
            });
            jumpTarget = null;
          };
          const jumpTo = (hash: string) => {
            const id = decodeURIComponent(hash.slice(1));
            jumpTarget = id ? document.getElementById(id) : null;
            revealJumpTarget();
          };
          // Arrived at a #section from another page.
          if (location.hash) jumpTo(location.hash);
          // A #section link on this page. Watching clicks, not hashchange,
          // also catches a second click when the hash is already #contact.
          document.addEventListener("click", (event) => {
            const link = (event.target as Element | null)?.closest<HTMLAnchorElement>("a[href*='#']");
            if (!link) return;
            const url = new URL(link.href, location.href);
            if (url.hash && url.pathname === location.pathname && url.search === location.search) jumpTo(url.hash);
          });
          window.addEventListener("hashchange", () => jumpTo(location.hash));

          // Safety net: a fast scroll can outrun the observer, so also check on
          // scroll and reveal anything that has reached the screen.
          let queued = false;
          window.addEventListener(
            "scroll",
            () => {
              if (queued) return;
              queued = true;
              setTimeout(() => {
                queued = false;
                revealJumpTarget();
                document.querySelectorAll<HTMLElement>("[data-reveal]:not(.is-visible)").forEach((el) => {
                  if (!onScreen(el)) return;
                  reveal(el);
                  observer.unobserve(el);
                });
              }, 120);
            },
            { passive: true },
          );
        } else {
          document.querySelectorAll("[data-reveal]").forEach(reveal);
        }
      });
    </script>
  </body>
</html>
